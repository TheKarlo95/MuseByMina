---
import { THEME_INIT_SCRIPT } from '../lib/theme';
import { langInitScript } from '../lib/lang';
import {
  DEFAULT_LOCALE,
  LOCALES,
  LOCALE_HTML_LANG,
  localeUrl,
  routeKey,
  type Locale,
} from '../lib/i18n';
import { rootPath } from '../lib/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/globals.css';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Redirect non-Croatian browsers to /en. Homepage only. */
  detectLanguage?: boolean;
  /**
   * Does this page have a URL of its own that a crawler should index?
   *
   * The 404 does not: the host serves it in place of whatever was asked for, so any
   * canonical it declared would name a URL that is itself a 404 — and the hreflang
   * alternate would promise an `/en/404/` that does not exist. `noindex` is the honest
   * answer, and it keeps the MUSE-9 rule — every declared URL resolves 200 — exact
   * rather than carved around.
   */
  indexable?: boolean;
}

const {
  locale,
  title,
  description,
  detectLanguage = false,
  indexable = true,
} = Astro.props;

const route = routeKey(Astro.url.pathname);
const canonical = new URL(localeUrl(route, locale), Astro.site).href;
const skipLabel = locale === 'hr' ? 'Preskoči na sadržaj' : 'Skip to content';
---

<!doctype html>
<html lang={LOCALE_HTML_LANG[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* Before first paint — otherwise a viewer who chose light watches the page flip. */}
    <script is:inline set:html={THEME_INIT_SCRIPT} />
    {
      detectLanguage && (
        <script is:inline set:html={langInitScript(localeUrl('/', 'en'))} />
      )
    }

    <title>{title}</title>
    <meta name="description" content={description} />

    {/* `localeUrl` emits the trailing slash the host serves these at, so a canonical and
        its alternates all resolve 200 rather than 301ing (MUSE-9). */}
    {
      indexable ? (
        <Fragment>
          <link rel="canonical" href={canonical} />
          {LOCALES.map((l) => (
            <link
              rel="alternate"
              hreflang={LOCALE_HTML_LANG[l]}
              href={new URL(localeUrl(route, l), Astro.site).href}
            />
          ))}
          <link
            rel="alternate"
            hreflang="x-default"
            href={new URL(localeUrl(route, DEFAULT_LOCALE), Astro.site).href}
          />
        </Fragment>
      ) : (
        <meta name="robots" content="noindex, follow" />
      )
    }

    {/* ds-allow: theme-color takes no CSS variable, so the two brand grounds are
        literal here. Keep in sync with --plum / --cream in tokens.css. */}
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#420535" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#F7F2EE" />

    {/* `rootPath` joins the deploy base; interpolating `BASE_URL` directly depends on
        whether it happens to carry a trailing slash, and emits `/MuseByMinafonts/…` when
        it does not — a preload that 404s on the sub-path deploy (MUSE-8). */}
    <link
      rel="preload"
      href={rootPath('fonts/cormorant-garamond-latin.woff2')}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href={rootPath('fonts/inter-400-600-latin.woff2')}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {indexable && <meta property="og:url" content={canonical} />}
  </head>

  <body>
    <a class="skip-link" href="#main">{skipLabel}</a>
    {/*
      `indexable` is also the answer to "does this page have a URL of its own", which is
      what decides whether a language switcher can work at all — see Header's prop
      (MUSE-13).
    */}
    <Header locale={locale} localeSwitch={indexable} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
