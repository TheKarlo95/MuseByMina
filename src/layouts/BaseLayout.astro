---
/**
 * **First, and it has to stay first (MUSE-43).**
 *
 * `globals.css` is `@font-face`, the `:root` tokens, the reset and the element
 * defaults — the layer everything else overrides. Astro orders the stylesheets it emits
 * by *import-crawl order*, so the position of this line is what decides whether the
 * globals land before or after every scoped stylesheet in the built `<head>`, and
 * whether they land before or after the header's and footer's scoped rules inside the
 * one chunk they share. Below the component imports, as it was, the globals came
 * **last** on all nine pages, so the foundation won every tie instead of losing it.
 *
 * Nothing renders differently today — twelve full-page screenshots, six routes, both
 * themes, byte-identical across the move — because Astro's scoping means no global rule
 * currently *ties* with a component rule. That is a property of today's CSS, not an
 * invariant: one `:global()` escape hatch creates a tie, and `font-variant-numeric` is
 * single-valued, so a global `:root` winning one is how MUSE-14's `II:OO` comes back
 * with the column still neatly aligned.
 *
 * This is Astro's own documented advice, one level in: *import the layout component
 * before other imports so that it has the lowest precedence.* There is no config for
 * it — stylesheet order is not configurable in Astro, the import position is the only
 * lever — so `test/cascade.test.ts` asserts the resulting order against `dist` rather
 * than this comment asking nicely. MUSE-35 and MUSE-20 both moved the cascade by
 * adding an ordinary import, and a comment beside an import is not a guard.
 */
import '../styles/globals.css';

import { THEME_INIT_SCRIPT } from '../lib/theme';
import { langInitScript } from '../lib/lang';
import {
  DEFAULT_LOCALE,
  LOCALES,
  LOCALE_HTML_LANG,
  localeUrl,
  routeKey,
  type Locale,
} from '../lib/i18n';
import { getSiteSettings } from '../lib/sanity';
import { jsonLd, structuredData } from '../lib/structured-data';
/**
 * The faces the first paint needs — **this page's, not a fixed pair** (MUSE-74).
 *
 * This was two `?url` imports and two hand-written tags below, identical on all fifteen
 * pages in both locales. Both named faces every page does need, so the guard watching
 * them was green; four of the six were preloaded nowhere, and every Croatian diacritic
 * lives in the `latin-ext` half that was never among them. `src/lib/fonts.ts` holds the
 * whole rule, the files, and why the one content-dependent part of it is written down as
 * data rather than modelled. It imports no CSS, so its position here cannot move the
 * built `<head>` (MUSE-43).
 */
import { preloadFaces } from '../lib/fonts';
/**
 * The tab icons, as a registry rather than five tags written out below (MUSE-40).
 *
 * Every `href` in it is a `?url` import for the same reason the two fonts above are, and
 * the reasoning for the set — why there are two colour schemes, why the small sizes carry
 * more stroke weight than the artwork does, and why each scheme names an explicit
 * `media` — is all in `src/lib/icon.ts`. This module pulls in no CSS, so its position
 * here cannot move the built `<head>` (MUSE-43); it sits with the other asset imports
 * anyway, which are the ones already proven safe there.
 */
import { ICONS } from '../lib/icon';
/**
 * The link preview card (MUSE-69), and the `og:locale` spelling beside it.
 *
 * `src/lib/share-card.ts` holds the whole decision — Mina's upload if she has set one,
 * the composed brand card if not, and why that particular fallback is allowed in a
 * repository that makes a dangling reference fatal. Like `./icon`, this module pulls in
 * no CSS, so its position in this list cannot move the built `<head>` (MUSE-43).
 */
import { ogLocale, shareCard } from '../lib/share-card';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /**
   * May a stored choice or the browser's language route this page elsewhere? Homepage
   * only — a deep link must land where it points, for everyone (MUSE-10).
   *
   * `?lang=` is not gated on this: it works on every page, because it is the link itself
   * asking rather than an inference about the visitor (MUSE-33). See `src/lib/lang.ts`.
   */
  detectLanguage?: boolean;
  /**
   * Does this page have a URL of its own that a crawler should index?
   *
   * The 404 does not: the host serves it in place of whatever was asked for, so any
   * canonical it declared would name a URL that is itself a 404 — and the hreflang
   * alternate would promise an `/en/404/` that does not exist. `noindex` is the honest
   * answer, and it keeps the MUSE-9 rule — every declared URL resolves 200 — exact
   * rather than carved around.
   *
   * **This is a question about crawlers and nothing else.** It used to answer a second
   * one as well; see `localeTwin`.
   */
  indexable?: boolean;
  /**
   * Is there an addressable page for this route in each locale?
   *
   * The error page is the one place the answer is no, and it is the whole of MUSE-38.
   * GitHub Pages serves one root `404.html` for every unknown path, so `/404/`, `/en/404`
   * and `/en/404/` are all themselves 404s. Two things follow, and only two:
   *
   *   - the language switcher cannot render, because it is a prefix swap on the current
   *     route and would be two dead links on the one page a visitor reaches *because* a
   *     link was dead (MUSE-13);
   *   - `langInitScript` has nowhere to navigate, so it is handed no URL for either
   *     locale and its one `go()` becomes a no-op.
   *
   * What does **not** follow is that the page stops handling language. MUSE-13 wrote
   * `const localeRouting = indexable;` — true of today's pages, and a different claim —
   * so the error page shipped no `langInitScript` either, and MUSE-33's `?lang=`, which
   * acts on every page by design, was discarded rather than persisted on the one page a
   * stale link actually lands on. One flag was answering "should a crawler index this" and
   * "may this page route by language" at once; they are two props now, and neither is
   * derived from the other. `test/nav.test.ts` pins both the behaviour and the absence of
   * the alias, because an alias reads as a tidy-up rather than as a decision.
   *
   * A page with no twin still says which language it is written in, and the error page
   * answers that by being bilingual rather than by choosing client-side — see
   * `src/pages/404.astro`.
   */
  localeTwin?: boolean;
}

const {
  locale,
  title,
  description,
  detectLanguage = false,
  indexable = true,
  localeTwin = true,
} = Astro.props;

const route = routeKey(Astro.url.pathname);
const canonical = new URL(localeUrl(route, locale), Astro.site).href;

/**
 * This route in each locale — or `null` for a locale it has no page in.
 *
 * `langInitScript` navigates only to a locale it was handed a URL for, so this is the
 * single place "there is nowhere to send them" is said, and it is said per locale rather
 * than as a flag the script has to interpret (MUSE-38). On the error page both answers are
 * `null`: `Astro.url.pathname` there is `/404/`, so the URL this would otherwise compute is
 * `/en/404/`, which the host cannot serve either. Sending a 404 to another 404 in a
 * different language helps nobody — but *reading* the request and persisting it is not a
 * navigation, and that is the half that used to be missing.
 */
const localeHref = (l: Locale): string | null => (localeTwin ? localeUrl(route, l) : null);
const skipLabel = locale === 'hr' ? 'Preskoči na sadržaj' : 'Skip to content';

/**
 * The page's structured data (MUSE-31) — built here, from the same singleton the footer
 * renders, and emitted in exactly one place on the whole site.
 *
 * `getSiteSettings()` is memoised for the life of the build, so this is not a second
 * read: it is the *same promise* `Footer.astro` awaits on every page. That is the point
 * rather than an optimisation — "the block agrees with the visible page" is true by
 * construction when both project one object, and would be a thing to keep testing if
 * either assembled its own copy. `src/lib/structured-data.ts` has the long version.
 *
 * Gated on `indexable` for the same reason the canonical is: the host serves the 404's
 * body for any unknown path, so it has no URL of its own, and a block keyed on a URL that
 * is itself a 404 describes a page that does not exist.
 *
 * `Astro.site` is always set — `astro.config.mjs` always sets it — and is the only thing
 * that knows the deploy's origin, so no URL in the block names a host (MUSE-8).
 */
const settings = await getSiteSettings();

const ldJson = indexable
  ? jsonLd(
      structuredData({
        settings,
        locale,
        canonical,
        site: Astro.site!,
      }),
    )
  : undefined;

/**
 * The picture a shared link shows (MUSE-69).
 *
 * Off the *same* memoised `getSiteSettings()` the JSON-LD and the footer read, so the
 * card and the page cannot be describing two different reads of the dataset.
 *
 * **Not gated on `indexable`**, unlike the canonical, the hreflang cluster and the
 * JSON-LD above. Those are claims about a URL, and the error page has none — the host
 * serves its body for any unknown path, so a canonical it declared would name a 404.
 * An image is not a claim about a URL; it is the same class of thing as the tab icon
 * and `theme-color`, which the error page already carries (`src/lib/icon.ts`). And the
 * page already emits `og:title` and `og:description`, so withholding only the image is
 * precisely the bare text card this ticket is about, on the one page a dead shared link
 * actually reaches.
 *
 * `Astro.site` is the only thing that knows the deploy's origin and `astro.config.mjs`
 * always sets it, so the absolute URL a scraper needs is *derived* here rather than
 * written (MUSE-29, MUSE-42). An upload's URL is already absolute — Sanity's CDN is
 * another origin — and `new URL` leaves it alone, so there is one expression rather than
 * a branch.
 */
const card = shareCard(settings.shareImage, locale);
const cardUrl = new URL(card.src, Astro.site).href;
---

<!doctype html>
<html lang={LOCALE_HTML_LANG[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* Before first paint — otherwise a viewer who chose light watches the page flip. */}
    <script is:inline set:html={THEME_INIT_SCRIPT} />
    {/* Locale routing, also pre-paint: `?lang=` has to be honoured before the wrong
        language is painted, and it is honoured on every page (MUSE-33). `detect` is what
        narrows the *inferred* half — a stored choice, the browser's preference — to the
        homepage. Never move this into a component; it must block.

        Unconditional, which is MUSE-38: this used to be gated on `indexable` by way of an
        alias, so the error page silently dropped the one script that reads `?lang=`. A
        page with no locale twin is handled by `localeHref` answering `null` — the script
        ships, reads the request, persists it, and has nowhere to go. */}
    <script
      is:inline
      set:html={langInitScript({
        urlFor: localeHref,
        locale,
        detect: detectLanguage,
      })}
    />

    <title>{title}</title>
    <meta name="description" content={description} />

    {/* `localeUrl` emits the trailing slash the host serves these at, so a canonical and
        its alternates all resolve 200 rather than 301ing (MUSE-9). */}
    {
      indexable ? (
        <Fragment>
          <link rel="canonical" href={canonical} />
          {LOCALES.map((l) => (
            <link
              rel="alternate"
              hreflang={LOCALE_HTML_LANG[l]}
              href={new URL(localeUrl(route, l), Astro.site).href}
            />
          ))}
          <link
            rel="alternate"
            hreflang="x-default"
            href={new URL(localeUrl(route, DEFAULT_LOCALE), Astro.site).href}
          />
        </Fragment>
      ) : (
        <meta name="robots" content="noindex, follow" />
      )
    }

    {/* ds-allow: theme-color takes no CSS variable, so the two brand grounds are
        literal here. Keep in sync with --plum / --cream in tokens.css. */}
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#420535" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#F7F2EE" />

    {/* The tab icons (MUSE-40), beside the theme colours because they are the same
        question — what the browser's own chrome shows for this page — answered for the
        two colour schemes §11 requires. The set, the two variants and the stroke weight
        the small sizes carry are all `src/lib/icon.ts`; emitting it from the registry is
        what lets `test/icon.test.ts` assert the page declares that set and no other. */}
    {
      ICONS.map((icon) => (
        <link rel={icon.rel} type="image/png" sizes={icon.sizes} href={icon.href} media={icon.media} />
      ))
    }

    {/* Every href comes from a `?url` import in `src/lib/fonts.ts` — see the note there.
        Never spell one of these out: a hand-written path has to join the deploy base
        (MUSE-8) and then has to keep agreeing with what `fonts.css` asks for (MUSE-35).
        The set is per page and per locale (MUSE-74); `test/fonts.test.ts` measures what
        each page actually asks the CSS engine for and fails in **both** directions. */}
    {
      preloadFaces(route, locale).map((face) => (
        <link
          rel="preload"
          href={face.href}
          as="font"
          type="font/woff2"
          crossorigin="anonymous"
        />
      ))
    }

    <meta property="og:type" content="website" />
    {/* Who published this, in the words Mina chose (MUSE-75).

        With no `og:site_name` a scraper has to guess, and what it guesses is the host:
        a real unfurl of this site named the publisher **„github.io"**. The field is the
        one piece of Open Graph that is about the studio rather than about the page, so
        it comes off the same memoised `getSiteSettings()` the footer, the JSON-LD block
        and the share card read — `settings.studioName`, already in the CMS and already
        rendered in the footer's copyright line. A literal here would be a fifth surface
        for an address-shaped field to drift on (MUSE-50).

        Not gated on `indexable`, for `og:image`'s reason: the publisher's name is not a
        claim about a URL, and the error page is the one page a dead shared link reaches. */}
    <meta property="og:site_name" content={settings.studioName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {indexable && <meta property="og:url" content={canonical} />}

    {/* The card (MUSE-69). `og:image:width`/`height` are not padding: Facebook's own
        documentation says a card with neither renders without an image the *first* time
        a URL is shared, because the layout happens before the fetch. `src/lib/share-card.ts`
        answers both for an upload too, from the asset id rather than by guessing.

        No `og:image:type`: an upload is served through `auto=format`, so the CDN picks
        AVIF, WebP or the original per request and a declared MIME type would be a claim
        the bytes can contradict.

        `twitter:*` beside them because X reads `twitter:card` and nothing else to decide
        between a thumbnail and a large card; the image and alt are the same two values,
        emitted from the same expressions so they cannot drift. */}
    <meta property="og:locale" content={ogLocale(LOCALE_HTML_LANG[locale])} />
    <meta property="og:image" content={cardUrl} />
    <meta property="og:image:alt" content={card.alt} />
    <meta property="og:image:width" content={String(card.width)} />
    <meta property="og:image:height" content={String(card.height)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={cardUrl} />
    <meta name="twitter:image:alt" content={card.alt} />

    {/* The site's only `application/ld+json` tag, and `test/structured-data.test.ts`
        asserts that it is the only one: a second emission site is a second answer to
        "does the markup agree with the page". `is:inline` because this is data, not a
        module — Astro must not try to bundle it, and nothing may ship as a `.js` file
        (`test/nojs.test.ts`). `set:html` because the payload is already JSON. */}
    {ldJson && <script type="application/ld+json" is:inline set:html={ldJson} />}
  </head>

  <body>
    <a class="skip-link" href="#main">{skipLabel}</a>
    {/*
      Whether a language switcher can work at all is "does this route have a page in each
      locale" — `localeTwin`, not `indexable` (MUSE-38). The two agree on every page the
      site has today and are not the same question; see Header's prop (MUSE-13).
    */}
    <Header locale={locale} localeSwitch={localeTwin} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
