---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Blog from '../../components/Blog.astro';
import { BLOG_ROUTE } from '../../lib/blog';
import { getPage, getPosts } from '../../lib/sanity';

const now = new Date();
const [meta, posts] = await Promise.all([
  getPage(BLOG_ROUTE),
  getPosts({ minimum: 0, now }),
]);
---

<BaseLayout locale="en" title={meta.title.en} description={meta.description.en}>
  <Blog locale="en" posts={posts} />
</BaseLayout>
