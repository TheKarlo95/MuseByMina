---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Home from '../../components/Home.astro';
import { getPage, getSiteSettings } from '../../lib/sanity';

const [meta, settings] = await Promise.all([getPage('/'), getSiteSettings()]);
---

<BaseLayout locale="en" title={meta.title.en} description={meta.description.en}>
  <Home locale="en" address={settings.address} />
</BaseLayout>
