---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Home from '../../components/Home.astro';
import { getPage, getSchedule, getSiteSettings } from '../../lib/sanity';

const [meta, settings, entries] = await Promise.all([
  getPage('/'),
  getSiteSettings(),
  getSchedule(),
]);
---

<BaseLayout locale="en" title={meta.title.en} description={meta.description.en}>
  <Home locale="en" address={settings.address} entries={entries} />
</BaseLayout>
