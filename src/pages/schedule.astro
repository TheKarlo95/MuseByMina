---
import BaseLayout from '../layouts/BaseLayout.astro';
import Schedule from '../components/Schedule.astro';
import { getPage, getSchedule } from '../lib/sanity';

const [meta, entries] = await Promise.all([getPage('/schedule'), getSchedule()]);
---

<BaseLayout locale="hr" title={meta.title.hr} description={meta.description.hr}>
  <Schedule locale="hr" entries={entries} />
</BaseLayout>
