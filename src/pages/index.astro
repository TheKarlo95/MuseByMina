---
import BaseLayout from '../layouts/BaseLayout.astro';
import Home from '../components/Home.astro';
import { getPage, getSchedule, getSiteSettings } from '../lib/sanity';

const [meta, settings, entries] = await Promise.all([
  getPage('/'),
  getSiteSettings(),
  getSchedule(),
]);
---

<BaseLayout
  locale="hr"
  title={meta.title.hr}
  description={meta.description.hr}
  detectLanguage
>
  <Home locale="hr" address={settings.address} entries={entries} />
</BaseLayout>
