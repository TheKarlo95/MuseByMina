---
import BaseLayout from '../layouts/BaseLayout.astro';
import Home from '../components/Home.astro';
import heroPoster from '../assets/hero-poster.webp?url';
// No `no-inline`: the file is three hundred times Vite's 4 KB inline threshold, so the
// suffix would be a word that does nothing, which is what `src/lib/icon.ts` warns about.
import heroVideo from '../assets/hero.webm?url';
import { homeContent } from '../lib/home';
import {
  getInstructors,
  getPage,
  getPricingTiers,
  getSchedule,
  getSiteSettings,
  getStudioStory,
} from '../lib/sanity';

const [meta, settings, entries, story, tiers, instructors] = await Promise.all([
  getPage('/'),
  getSiteSettings(),
  getSchedule(),
  getStudioStory(),
  getPricingTiers(),
  getInstructors(),
]);

const content = homeContent('hr', { story, tiers, instructors });
---

<BaseLayout
  locale="hr"
  title={meta.title.hr}
  description={meta.description.hr}
  detectLanguage
>
  <Home
    locale="hr"
    address={settings.address}
    entries={entries}
    hero={{ video: heroVideo, poster: heroPoster }}
    story={content.story}
    rates={content.rates}
    people={content.people}
  />
</BaseLayout>
