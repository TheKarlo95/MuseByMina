---
import BaseLayout from '../layouts/BaseLayout.astro';
import Home from '../components/Home.astro';
import { getPage, getSiteSettings } from '../lib/sanity';

const [meta, settings] = await Promise.all([getPage('/'), getSiteSettings()]);
---

<BaseLayout
  locale="hr"
  title={meta.title.hr}
  description={meta.description.hr}
  detectLanguage
>
  <Home locale="hr" address={settings.address} />
</BaseLayout>
