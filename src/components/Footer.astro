---
import { MORE_NAV, PRIMARY_NAV, STUDIO } from '../lib/nav';
import { localeUrl, routeKey, type Locale } from '../lib/i18n';
import { addressLines, getSiteSettings, socialUrl } from '../lib/sanity';
import Lockup from './Lockup.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const t = {
  hr: {
    links: 'Brzi linkovi',
    find: 'Gdje smo',
    openMaps: 'Otvori u Google Maps',
    social: 'Pratite nas',
    privacy: 'Izjava o privatnosti',
  },
  en: {
    links: 'Quick links',
    find: 'Find us',
    openMaps: 'Open in Google Maps',
    social: 'Follow us',
    privacy: 'Privacy notice',
  },
}[locale];

/**
 * The footer is an index, not a second copy of the desktop bar.
 *
 * It used to drop every `mobileOnly` entry, which is a rule about horizontal space in a
 * 64px band and means nothing in a four-column grid — and with the dead routes gone
 * (MUSE-13) it left this column with two links while the mobile panel listed three. So
 * it takes the whole primary list, the way the mobile panel does, plus the head of
 * "More" once there is a "More" to take a head of.
 */
const quick = [...PRIMARY_NAV, ...MORE_NAV.slice(0, 4)];
const year = 2026;

/** The privacy notice's route, named once because two places below have to agree on it. */
const PRIVACY = '/privacy';

/**
 * Which route the visitor is on — so the footer can say so (MUSE-38).
 *
 * The footer carried no `aria-current` at all, and `/privacy/` is reachable *only* from
 * here: the nav omits it on purpose (MUSE-7), so on the one page the primary nav cannot
 * mark, nothing did. `routeKey` strips the deploy base and the locale prefix, the same way
 * `Header.astro` gets the value it compares — the two lists are the same routes and must
 * not disagree about where you are.
 *
 * The marked entry stays an `<a>`. MUSE-39 made the locale switcher's own-locale entry an
 * inert `<span aria-current="page">`, and that suite states the rule behaviourally:
 * whatever carries `aria-current` must either not be a link, or be a link to exactly where
 * we already are. The switcher's href failed that — MUSE-33 had stamped `?lang=` onto it,
 * so it pointed at an address the visitor was not at. A footer entry for the current route
 * points at exactly the current URL, which satisfies the rule as a link, and keeping it one
 * matches the nav, keeps a reload available, and leaves `/privacy/` with the self-reference
 * `test/nav.test.ts`'s orphan rule is calibrated against. `page` rather than `true`, for
 * the reason spelled out in `LocaleSwitch.astro`: this is one page out of a set of pages.
 */
const here = routeKey(Astro.url.pathname);

/**
 * The studio's own details come from Sanity (MUSE-20), the address included.
 *
 * `addressLines` splits the one `address` field into the two lines this `<address>`
 * element needs, and fails the build naming the document if it cannot — see the note
 * there for why splitting beat adding two more fields. Only the country and the maps
 * link are still code: a translated word and a URL the schema has no field for.
 *
 * The social links are asked for by name rather than mapped over the array: the link
 * text and the order are the design's (§7.1), while the address is content. A platform
 * missing from Sanity then fails the build naming the document, instead of rendering a
 * link with no href — see `socialUrl`.
 *
 * This read is **frontmatter**: it runs in Node during the build and is never bundled.
 * A `<script>` in this file may not import the read path, and `test/sanity.test.ts`
 * asserts that by splitting the file at the fence.
 */
const settings = await getSiteSettings();

/**
 * **How wide the lockup is drawn here, in CSS pixels** (MUSE-64).
 *
 * 130, against design system §12's 100px minimum. The footer is the one surface on the
 * site with room for the lockup at a size §12 is satisfied by: this column is `1.4fr` of
 * a four-track grid inside a 1280px inner, so about 376px wide on desktop and the full
 * gutter-to-gutter width on mobile.
 *
 * The number is set by the **clear space**, not by the column width. §12 wants the cap
 * height of "MUSE" on all four sides, which at 130px is 31px, and 31px is what every
 * neighbour here can afford: the grid gap between footer columns is `--space-6` (32px),
 * the inner's desktop gutter is `--space-7` (48px) and its top padding is `--space-9`.
 * Draw it at 160px instead and the clear space becomes 38px — wider than the 32px gap —
 * so the lockup would be 6px short of its own rule against the column beside it, on the
 * one surface where the rule can be kept. 130px keeps it everywhere.
 *
 * The masthead is the surface that cannot, and that is the finding MUSE-64 reports
 * rather than works around: at 100px the lockup is 73px tall, and the header band is
 * 64px on mobile and 80px on desktop (§7.1). It does not fit at §12's minimum with the
 * clear space, and on mobile it does not fit at §12's minimum at all. §12's own variants
 * table names the **icon-only mark** as the compact header's variant, and that artwork
 * does not exist — MUSE-40, blocked. See the note in `Header.astro`.
 */
const LOCKUP_WIDTH = 130;
const address = addressLines(settings);
---

<footer class="footer">
  <div class="inner">
    <div class="col">
      <Lockup width={LOCKUP_WIDTH} alt={settings.studioName} />
      <p class="blurb">
        {settings.tagline[locale]}
      </p>
    </div>

    <nav class="col" aria-label={t.links}>
      <h2 class="h">{t.links}</h2>
      <ul>
        {
          quick.map((i) => (
            <li>
              <a
                href={localeUrl(i.route, locale)}
                aria-current={here === i.route ? 'page' : undefined}
              >
                {i.label[locale]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="col">
      <h2 class="h">{t.find}</h2>
      <address>
        {address.street}<br />
        {address.city}, {STUDIO.country[locale]}
      </address>
      {/* Link-out, not an iframe: no third-party cookies and no LCP hit. */}
      <a class="mapLink" href={STUDIO.maps} target="_blank" rel="noopener noreferrer">
        {t.openMaps}
      </a>
      <a class="mail" href={`mailto:${settings.email}`}>{settings.email}</a>
    </div>

    <div class="col">
      <h2 class="h">{t.social}</h2>
      <ul>
        <li><a href={socialUrl(settings, 'instagram')} target="_blank" rel="noopener noreferrer me">Instagram</a></li>
        <li><a href={socialUrl(settings, 'facebook')} target="_blank" rel="noopener noreferrer me">Facebook</a></li>
        <li><a href={socialUrl(settings, 'linktree')} target="_blank" rel="noopener noreferrer me">Linktree</a></li>
      </ul>
    </div>
  </div>

  {/*
    The privacy notice lives here and nowhere else. The nav omits it on purpose (MUSE-7):
    it is the footnote the trial form links to, not a destination anyone sets out for —
    which is exactly why this link has to carry `aria-current` on the privacy page itself.
    No other chrome on the site can mark it (MUSE-38).
  */}
  <div class="bottom">
    <span>© {year} {settings.studioName}</span>
    <a
      class="bottomLink"
      href={localeUrl(PRIVACY, locale)}
      aria-current={here === PRIVACY ? 'page' : undefined}
    >
      {t.privacy}
    </a>
  </div>
</footer>

<style>
  /* --surface-deep is plum-ink in BOTH themes, so the footer is a constant anchor
     at the bottom of every page. Design system §7.1. */
  .footer {
    background: var(--band-surface);
    color: var(--band-text);
    margin-top: var(--space-10);
  }

  .inner {
    max-width: 1280px;
    margin-inline: auto;
    padding: var(--space-8) var(--space-5);
    display: grid;
    gap: var(--space-7);
  }
  @media (min-width: 768px) {
    .inner {
      grid-template-columns: 1.4fr 1fr 1fr 1fr;
      padding: var(--space-9) var(--space-7);
      gap: var(--space-6);
    }
  }

  .blurb {
    font-size: 0.875rem;
    color: var(--band-muted);
    max-width: 34ch;
  }

  .h {
    font-family: var(--font-label);
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.28em;
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--band-accent);
    margin: 0 0 var(--space-4);
  }

  ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  a {
    color: var(--band-muted);
    text-decoration: none;
    font-size: 0.875rem;
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    transition: color var(--dur-fast) var(--ease);
  }
  a:hover {
    color: var(--band-accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  /* The entry for the page you are on, styled the same way the nav styles its own
     (MUSE-38). Colour alone is enough here because the state is in the markup rather
     than in the paint: `aria-current` is what carries it, and §11.1's rule is about a
     link being distinguishable from text, which every link in this list already is by
     position in a labelled list. */
  a[aria-current='page'] {
    color: var(--band-accent);
  }

  address {
    font-style: normal;
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--band-muted);
    margin-bottom: var(--space-2);
  }
  .mapLink,
  .mail {
    display: block;
  }
  .mapLink {
    color: var(--band-accent);
  }

  .bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-2) var(--space-5);
    border-top: 1px solid var(--band-line);
    padding: var(--space-4) var(--space-5);
    text-align: center;
    font-size: 0.75rem;
    color: var(--band-subtle);
  }
  /* Underlined at rest, not only on hover: it sits beside the copyright line, and a link
     that is only distinguishable by colour fails §11.1 whichever colour it is. */
  .bottomLink {
    font-size: 0.75rem;
    color: var(--band-muted);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
