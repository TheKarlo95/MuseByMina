---
// **This import's position is load-bearing for the bytes of `/contact`.** Measured:
//
//   this file as it is now ..................... <style>, TrialForm, BaseLayout
//   any *new* module imported below TrialForm ... TrialForm, <style>, BaseLayout
//   a module already in the graph, below it ..... unchanged
//
// Astro orders a page's stylesheets by the order it crawls the page's imports. This
// component's own styles are inlined and `TrialForm`'s are an external `<link>`, so
// introducing a module to the graph below the `TrialForm` import moves the inlined block
// past that `<link>`. Both are scoped, so nothing renders differently — but MUSE-20 is a
// migration whose acceptance test is a byte-for-byte `diff -r` against the previous
// deploy, and a moved `<style>` is a byte.
//
// Which positions are safe is a property of the individual file, not a rule: `Home.astro`
// has the same exposure and tolerates the import *nowhere* (three placements tried, three
// identical diffs), which is why it takes the address as a prop instead. If you add an
// import to a component that renders `TrialForm`, build and `diff -r`.
//
// What *is* now a guard rather than a comment: `test/cascade.test.ts` (MUSE-43) pins the
// global layer to the front of every page's `<head>` and names the component whose
// imports moved. It does not pin two scoped sheets against each other — they cannot tie,
// so swapping them changes bytes and nothing else — so the paragraph above is still the
// only thing watching that, and it is still only a comment.
import { getSiteSettings, socialUrl } from '../lib/sanity';
import TrialForm from './TrialForm.astro';
import { localeUrl, type Locale } from '../lib/i18n';
import { STUDIO } from '../lib/nav';

/**
 * `/contact` — the same trial form as `/#trial`, given a page of its own.
 *
 * It exists because the nav's Contact entry has pointed at a 404 since the rebuild, and
 * because a link someone can send a friend ("prijavi se ovdje") should not be a fragment
 * halfway down the homepage.
 */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

/**
 * Contact details are content (MUSE-20), the address included — rendered whole here, and
 * split into two lines in the footer. Only the maps link is still code; the schema has no
 * field for it.
 */
const settings = await getSiteSettings();

const t = {
  hr: {
    // MUSE-71: the eyebrow used to price the first class at nothing. It names the
    // subject of the hero instead, which is what every other eyebrow on the site does.
    eyebrow: 'Prvi sat',
    h1: 'Dođi na probni sat',
    lede:
      'Bez partnera, bez iskustva, bez obveze. Ispuni obrazac i javljamo se s terminom koji ti odgovara.',
    formHeading: 'Prijavi se',
    elseHeading: 'Ili nam se javi direktno',
    elseLede: 'Ako ti je obrazac prekomplicirano, piši nam ili nas pronađi na društvenim mrežama.',
    where: 'Gdje smo',
    openMaps: 'Otvori u Google Maps',
    schedule: 'Pogledaj raspored',
  },
  en: {
    eyebrow: 'First class',
    h1: 'Come to a trial class',
    lede:
      'No partner, no experience, no commitment. Fill in the form and we will come back with a time that suits you.',
    formHeading: 'Sign up',
    elseHeading: 'Or reach us directly',
    elseLede: 'If a form is one step too many, write to us or find us on social media.',
    where: 'Where we are',
    openMaps: 'Open in Google Maps',
    schedule: 'See the schedule',
  },
}[locale];
---

<section class="hero">
  <p class="eyebrow">{t.eyebrow}</p>
  <h1 class="display">{t.h1}</h1>
  <p class="lede">{t.lede}</p>
</section>

<section class="section sunken">
  <div class="wrap">
    <h2 class="displayM">{t.formHeading}</h2>
    <TrialForm locale={locale} />
  </div>
</section>

<section class="section">
  <div class="wrap">
    <p class="eyebrow">{t.elseHeading}</p>
    <h2 class="displayM">{settings.address}</h2>
    <p class="lede">{t.elseLede}</p>

    <ul class="links">
      <li><a class="link" href={`mailto:${settings.email}`}>{settings.email}</a></li>
      <li>
        <a class="link" href={socialUrl(settings, 'instagram')} target="_blank" rel="noopener noreferrer me">
          Instagram
        </a>
      </li>
      <li>
        <a class="link" href={STUDIO.maps} target="_blank" rel="noopener noreferrer">
          {t.openMaps}
        </a>
      </li>
    </ul>

    <a class="btn btnSecondary" href={localeUrl('/schedule', locale)}>{t.schedule}</a>
  </div>
</section>

<style>
  .hero {
    max-width: 1280px;
    margin-inline: auto;
    padding: var(--space-8) var(--space-5) var(--space-7);
  }
  @media (min-width: 768px) {
    .hero {
      padding: var(--space-10) var(--space-7) var(--space-8);
    }
  }

  .section {
    padding: var(--space-8) var(--space-5);
  }
  @media (min-width: 768px) {
    .section {
      padding: var(--space-10) var(--space-7);
    }
  }
  .sunken {
    background: var(--surface-sunken);
  }
  .wrap {
    max-width: 1280px;
    margin-inline: auto;
  }

  .eyebrow {
    font-family: var(--font-label);
    font-weight: 300;
    font-size: 0.75rem;
    letter-spacing: 0.32em;
    /* Č Ć Ž Š carry marks above the cap line — 1.4 is the floor in Croatian (§4.6) */
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0;
    max-width: none;
  }

  .display {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.75rem, 9vw, 6rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    text-wrap: balance;
    margin: var(--space-4) 0 0;
  }
  .displayM {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.125rem, 5vw, 3.75rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-wrap: balance;
    margin: 0;
  }

  .lede {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--text-muted);
    margin-top: var(--space-5);
  }

  .links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: var(--space-6);
  }
  .link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--accent);
    text-underline-offset: 4px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    margin-top: var(--space-6);
    padding-inline: var(--space-6);
    border-radius: var(--radius-full);
    border: 1px solid transparent;
    font-family: var(--font-label);
    font-size: 0.8125rem;
    letter-spacing: 0.28em;
    line-height: 1.4;
    text-transform: uppercase;
    text-decoration: none;
    transition:
      transform var(--dur-fast) var(--ease),
      filter var(--dur-fast) var(--ease);
  }
  @media (min-width: 768px) {
    .btn {
      min-height: 56px;
    }
  }
  .btn:hover {
    transform: translateY(-1px);
    filter: brightness(1.06);
  }
  .btnSecondary {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>
