---
import { LOCALES, LOCALE_LABEL, localeUrl, routeKey, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

// The equivalent page, not the homepage. Because paths are English and shared
// across locales, this is a straight prefix swap with no slug table to maintain.
const route = routeKey(Astro.url.pathname);
const label = locale === 'hr' ? 'Jezik' : 'Language';
---

{/*
  The locale being read is a label, not a link (MUSE-39).

  MUSE-33 stamped `?lang=` onto every href so that a switcher link names the language it
  leads to — which is right, and is what makes middle-click and "copy link address" land
  in the right language. It stamped the own-locale href too, so `/en/schedule/`'s EN entry
  pointed at `/en/schedule/?lang=en`: activating the language you were already reading
  reloaded the document, and `aria-current` sat on a link that did not point at the current
  address, which is the one thing that attribute asserts.

  The ticket offered the alternative of keeping the `<a>` and pointing it at the current
  URL unchanged, which keeps the markup symmetrical. It is not taken, for three reasons:

    - A link to the URL you are already at is *not* inert. With no fragment to match,
      following it is a same-URL navigation and the browser re-requests the document;
      making it do nothing would need a `preventDefault` click handler, and a click
      handler is exactly what MUSE-16 and MUSE-33 spent two tickets moving behaviour out
      of. Here it would have to intercept the keyboard too, and still leave middle-click
      opening a pointless second tab.
    - `aria-current` would then be load-bearing in two directions at once: the href has to
      track `location` on every `hashchange` for the attribute to stay honest, so the
      accuracy MUSE-39 is about would depend on a rewrite firing.
    - There is nothing for the link to offer. It is one of two entries in a labelled
      group, so a screen reader still reads "HR, EN, current page" — what it no longer
      does is announce a second link to where the visitor already is, or spend a tab
      stop on it.

  `page` rather than `true`: `true` is the generic fallback for a set with no better
  token, and this is one page out of a set of pages, which is what `Header.astro`'s nav
  already says. `hreflang` is deliberately not carried over — it is defined for `a`,
  `area` and `link`, and the page's own `<head>` is where the alternates are declared.
*/}
<div class="group" role="group" aria-label={label} data-locale-switch>
  {
    LOCALES.map((l) =>
      l === locale ? (
        <span lang={l} data-locale={l} aria-current="page">
          {LOCALE_LABEL[l]}
        </span>
      ) : (
        <a href={localeUrl(route, l)} hreflang={l} lang={l} data-locale={l}>
          {LOCALE_LABEL[l]}
        </a>
      ),
    )
  }
</div>

<script>
  import { isLocale } from '../lib/i18n';
  import { carryLocation } from '../lib/lang';

  // Links only, which since MUSE-39 is the *other* locale's entry and nothing else: the
  // one for the locale being read is a `<span>`, so there is no own-locale href for a
  // rewrite to reach and no `?lang=` pointing at the address the visitor is already at.
  const links = [
    ...document.querySelectorAll<HTMLAnchorElement>('[data-locale-switch] a'),
  ];

  // The href rendered above: the equivalent page in that locale, with neither query nor
  // fragment, because `Astro.url.pathname` has neither to give. Kept aside so repeated
  // syncs rewrite from the clean URL rather than appending to their own output.
  const rendered = new Map(links.map((a) => [a, a.getAttribute('href') ?? '']));

  /**
   * Point each link at the *current* URL's query and fragment, and at its own locale.
   *
   * A fragment is never sent to the server, so this is the only place it can be attached
   * (MUSE-16). Done as an href rewrite rather than inside the click handler so that every
   * way of following the link benefits — middle-click, "open in new tab", and "copy link
   * address" never fire a `click` event, and a switcher that only worked for a plain left
   * click would still be dropping the fragment for everyone else.
   *
   * That argument applies just as much to *recording* the choice, which is what MUSE-33
   * found still sitting in the click handler: a middle-clicked HR link opened a new tab at
   * a bare `/MuseByMina/#trial` with nothing stored, and the homepage redirect bounced a
   * non-Croatian browser to `/en/`. So the locale goes into the href as `?lang=`, where
   * every path that follows the link carries it, and `src/lib/lang.ts` persists it on
   * arrival. There is no click handler to miss, and the URL a visitor copies out of the
   * address bar is a link to the language they are reading.
   */
  const sync = () => {
    for (const a of links) {
      const locale = a.dataset.locale;
      if (!isLocale(locale)) continue;
      const href = rendered.get(a);
      if (href === undefined) continue;
      a.setAttribute('href', carryLocation(href, locale, location.search, location.hash));
    }
  };

  sync();
  // The fragment is live: a visitor who lands on `/en/` and then clicks the header CTA to
  // `#trial` has changed where the switcher should take them, without any navigation.
  addEventListener('hashchange', sync);
  addEventListener('popstate', sync);

  // Belt and braces: the href is read after this handler returns, so a URL changed by
  // something that fired neither event above is still caught at the moment it matters.
  //
  // Nothing is written to storage here. The href carries `?lang=`, so the choice is
  // recorded by the page that is navigated to — for a left click and for every way of
  // following a link that never reaches a `click` handler alike (MUSE-33).
  for (const a of links) a.addEventListener('click', sync);
</script>

<style>
  .group {
    display: inline-flex;
    align-items: center;
  }
  /* Both entries are laid out identically; only one of them is a link (MUSE-39). */
  .group a,
  .group span {
    /* 44px tap target without inflating the type — design system §7.1 */
    min-width: 44px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-label);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    line-height: 1.4;
    text-decoration: none;
    color: var(--band-subtle);
    transition: color var(--dur-fast) var(--ease);
  }
  .group a:hover {
    color: var(--band-accent);
  }
  .group [aria-current='page'] {
    color: var(--band-accent);
  }
  /* Child-wise rather than `a + a`: the own-locale entry is first on Croatian pages
     and second on English ones, so the divider cannot be anchored to a tag name. */
  .group > * + * {
    border-left: 1px solid var(--band-line);
  }
</style>
