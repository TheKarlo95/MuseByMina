---
import { LOCALES, LOCALE_LABEL, localeUrl, routeKey, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

// The equivalent page, not the homepage. Because paths are English and shared
// across locales, this is a straight prefix swap with no slug table to maintain.
const route = routeKey(Astro.url.pathname);
const label = locale === 'hr' ? 'Jezik' : 'Language';
---

<div class="group" role="group" aria-label={label} data-locale-switch>
  {
    LOCALES.map((l) => (
      <a
        href={localeUrl(route, l)}
        hreflang={l}
        lang={l}
        data-locale={l}
        aria-current={l === locale ? 'true' : undefined}
      >
        {LOCALE_LABEL[l]}
      </a>
    ))
  }
</div>

<script>
  import { isLocale } from '../lib/i18n';
  import { carryLocation } from '../lib/lang';

  const links = [
    ...document.querySelectorAll<HTMLAnchorElement>('[data-locale-switch] a'),
  ];

  // The href rendered above: the equivalent page in that locale, with neither query nor
  // fragment, because `Astro.url.pathname` has neither to give. Kept aside so repeated
  // syncs rewrite from the clean URL rather than appending to their own output.
  const rendered = new Map(links.map((a) => [a, a.getAttribute('href') ?? '']));

  /**
   * Point each link at the *current* URL's query and fragment, and at its own locale.
   *
   * A fragment is never sent to the server, so this is the only place it can be attached
   * (MUSE-16). Done as an href rewrite rather than inside the click handler so that every
   * way of following the link benefits — middle-click, "open in new tab", and "copy link
   * address" never fire a `click` event, and a switcher that only worked for a plain left
   * click would still be dropping the fragment for everyone else.
   *
   * That argument applies just as much to *recording* the choice, which is what MUSE-33
   * found still sitting in the click handler: a middle-clicked HR link opened a new tab at
   * a bare `/MuseByMina/#trial` with nothing stored, and the homepage redirect bounced a
   * non-Croatian browser to `/en/`. So the locale goes into the href as `?lang=`, where
   * every path that follows the link carries it, and `src/lib/lang.ts` persists it on
   * arrival. There is no click handler to miss, and the URL a visitor copies out of the
   * address bar is a link to the language they are reading.
   */
  const sync = () => {
    for (const a of links) {
      const locale = a.dataset.locale;
      if (!isLocale(locale)) continue;
      const href = rendered.get(a);
      if (href === undefined) continue;
      a.setAttribute('href', carryLocation(href, locale, location.search, location.hash));
    }
  };

  sync();
  // The fragment is live: a visitor who lands on `/en/` and then clicks the header CTA to
  // `#trial` has changed where the switcher should take them, without any navigation.
  addEventListener('hashchange', sync);
  addEventListener('popstate', sync);

  // Belt and braces: the href is read after this handler returns, so a URL changed by
  // something that fired neither event above is still caught at the moment it matters.
  //
  // Nothing is written to storage here. The href carries `?lang=`, so the choice is
  // recorded by the page that is navigated to — for a left click and for every way of
  // following a link that never reaches a `click` handler alike (MUSE-33).
  for (const a of links) a.addEventListener('click', sync);
</script>

<style>
  .group {
    display: inline-flex;
    align-items: center;
  }
  .group a {
    /* 44px tap target without inflating the type — design system §7.1 */
    min-width: 44px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-label);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    line-height: 1.4;
    text-decoration: none;
    color: var(--band-subtle);
    transition: color var(--dur-fast) var(--ease);
  }
  .group a:hover {
    color: var(--band-accent);
  }
  .group a[aria-current='true'] {
    color: var(--band-accent);
  }
  .group a + a {
    border-left: 1px solid var(--band-line);
  }
</style>
