---
import { type Locale } from '../lib/i18n';
import { addressLines, getSiteSettings } from '../lib/sanity';
import {
  classCount,
  daysWithClasses,
  entriesAt,
  formatNames,
  formatTime,
  groupByDay,
  LEVEL_NAME,
  LEVEL_PREREQUISITE,
  minutesPhrase,
  timeRows,
  uniformDuration,
  WEEKDAY_NAME,
  type ClassEntry,
} from '../lib/schedule';

/**
 * The weekly schedule — design system §7.2, "the largest responsive shift in the
 * system".
 *
 * Two layouts, one dataset, rendered from the same `entries` array at build time:
 *
 *   < 768px   an accordion by day. Collapsed row = day + session count + chevron;
 *             expanded shows the class rows.
 *   >= 768px  a day × time grid: days across, times down the left gutter, classes
 *             as raised blocks with a 2px accent left border.
 *
 * Both are emitted and CSS picks one, rather than one DOM re-flowed by script.
 * A media query cannot turn a list of days into a table of times, and the other
 * way round — a `<details>` laid out with `display: contents` — loses the native
 * disclosure behaviour that AC6 ("operable by keyboard alone") depends on. The
 * cost is the markup appearing twice in the HTML; the hidden copy is
 * `display: none`, so it is out of the accessibility tree and read once.
 *
 * **It is real HTML, never an image.** An image of a schedule is unreadable on a
 * phone, invisible to search, and out of date the day it is exported.
 *
 * **There is no filter and no script** (MUSE-135). A level picker — an "all" chip plus
 * one per entry in `LEVELS` — stood above the schedule until 2026-10-22, revealed by this
 * component's own `<script>`, which existed for it and for nothing else. It narrowed four
 * classes across two evenings, and MUSE-36 had already deleted the other dimension with
 * `STYLES`. What is left is two server-rendered layouts and a `<details>`, so the page
 * ships no JavaScript of its own at all and „operable by keyboard alone" is the browser's
 * own disclosure behaviour rather than something this file maintains. Re-adding a filter
 * means re-adding a script: weigh it against four rows first. → `docs/decisions/pages.md`
 *
 * Data source: `entries` is **required** and comes from the CMS — the page wrappers pass
 * `await getSchedule()`. It used to default to thirteen invented rows in
 * `src/data/schedule.ts`, which is the bug MUSE-36 was raised for: the default made the
 * page renderable before anybody had asked the studio what it teaches, and it then stayed
 * live for the life of the project. There is no default now, so a `/schedule` with no
 * content is a build failure naming the missing documents rather than a page of fiction.
 * Nothing else in this file knows where the rows came from.
 */
interface Props {
  locale: Locale;
  /** The weekly timetable, from `getSchedule()`. No default — see above. */
  entries: ClassEntry[];
}

const { locale, entries } = Astro.props;

/**
 * How long a class is, **read off the rows rather than typed into the lede** (MUSE-36).
 *
 * The lede said „Satovi traju 60 minuta." while every class was 60 minutes, and went on
 * saying it after the real timetable turned out to be 90 — a sentence of copy disagreeing
 * with the table underneath it. Same failure as the homepage door that advertised a class
 * that was not there (MUSE-11), and the same fix: derive it. Classes of differing length
 * drop the sentence instead of picking one, because there is no honest single number then.
 */
const minutes = uniformDuration(entries);

/**
 * The street, from the CMS — the fifth address surface (MUSE-50).
 *
 * The eyebrow used to spell the street out as a literal, inside the composed label
 * below. MUSE-20 moved the address into `siteSettings` and rewired the footer, `/`,
 * `/contact` and the privacy notice to read it; this one was missed because the review
 * grepped for the identifier `STUDIO.street`, and an identifier search cannot see a
 * string buried in a longer one. The result was four surfaces that follow the Studio and
 * a fifth that does not — drift that shows itself only on the day the studio moves, which
 * is the one day anybody is relying on the CMS to fix it everywhere at once.
 *
 * `addressLines` is the same splitter the footer and the JSON-LD block use, so "the
 * street half of the address" has one definition rather than a second `split(',')` here.
 * The city half is deliberately not wanted: the label names the street beside the page's
 * own word for itself, and adding the city would be a different label.
 *
 * `test/contentdrift.test.ts` is the part that lasts — two edits do not stop a sixth
 * copy — and it is also why this comment does not quote the street. A stale copy in prose
 * is believed rather than noticed.
 */
const street = addressLines(await getSiteSettings()).street;

const t = {
  hr: {
    eyebrow: `Raspored · ${street}`,
    h1: 'Tjedni raspored',
    lede: [
      minutes === undefined ? undefined : `Satovi traju ${minutesPhrase(minutes, 'hr')}.`,
      'Dolaziš bez partnera i bez iskustva — razinu biraš po tome koliko dugo plešeš.',
    ]
      .filter(Boolean)
      .join(' '),
    time: 'Vrijeme',
    gridCaption: 'Tjedni raspored — dani u stupcima, vrijeme u redovima.',
    empty: 'Trenutno nema objavljenih termina.',
  },
  en: {
    eyebrow: `Schedule · ${street}`,
    h1: 'Weekly schedule',
    lede: [
      minutes === undefined ? undefined : `Classes run ${minutesPhrase(minutes, 'en')}.`,
      'Come without a partner and without experience — pick your level by how long you have been dancing.',
    ]
      .filter(Boolean)
      .join(' '),
    time: 'Time',
    gridCaption: 'Weekly schedule — days in columns, times in rows.',
    empty: 'No classes are published right now.',
  },
}[locale];

const days = groupByDay(entries);
const columns = daysWithClasses(entries);
const rows = timeRows(entries);
---

<section class="hero">
  <p class="eyebrow">{t.eyebrow}</p>
  <h1 class="display">{t.h1}</h1>
  <p class="lede">{t.lede}</p>
</section>

<section class="band">
  <div class="wrap">
    {
      /*
        The dataset's own empty state, server-rendered (MUSE-135).

        It used to read „Nema termina za odabrani filter." and was in the document on
        every load, `hidden`, waiting for a chip that emptied the schedule. With the
        filter gone nothing on the page can empty anything, so the sentence is about the
        **data**: every slot paused for the summer, or a term between schedules, renders
        a band with no accordion and a table holding one header cell.

        In code rather than in the CMS, which is `/events`, `/blog` and `/gallery`'s
        position (MUSE-24, MUSE-25, MUSE-26): it is a statement about what the dataset
        contains, and a field describing the dataset is a field Mina cannot keep true.

        `days` rather than `entries`, because `groupByDay` is what both layouts are cut
        from — an entry no day groups is an entry neither view paints.
      */
      days.length === 0 && <p class="empty">{t.empty}</p>
    }

    {/* --- under 768px: an accordion by day (design system §7.2) --- */}
    <div class="accordion" data-view="accordion">
      {
        days.map((group, i) => (
          <details class="day" data-day-group={group.day} open={i === 0}>
            <summary>
              <span class="dayName">{WEEKDAY_NAME[locale][group.day]}</span>
              <span class="daySide">
                <span class="dayCount">
                  {classCount(group.entries.length, locale)}
                </span>
                <span class="chev" aria-hidden="true" />
              </span>
            </summary>
            <ul class="slots">
              {group.entries.map((entry) => (
                <li class="slot" data-slot data-level={entry.level}>
                  <time class="slotTime" datetime={formatTime(entry.start)}>
                    {formatTime(entry.start)}
                  </time>
                  <span class="slotBody">
                    <span class="slotName">{entry.name[locale]}</span>
                    <span class="slotMeta">
                      {/* `data-level-name`: see the contract in Home.astro (MUSE-11). */}
                      <span data-level-name={entry.level}>
                        {LEVEL_NAME[locale][entry.level]}
                      </span>{' '}
                      · {formatNames(entry.instructors, locale)} · {entry.durationMin} min
                    </span>
                    <span class="slotPrereq">{LEVEL_PREREQUISITE[locale][entry.level]}</span>
                  </span>
                </li>
              ))}
            </ul>
          </details>
        ))
      }
    </div>

    {/* --- 768px and up: the same data as a day × time grid --- */}
    <div class="gridWrap" data-view="grid">
      <table class="grid">
        <caption class="srOnly">{t.gridCaption}</caption>
        <thead>
          <tr>
            <th scope="col" class="gutterHead"><span class="srOnly">{t.time}</span></th>
            {
              columns.map((day) => (
                <th scope="col" class="dayHead">
                  {WEEKDAY_NAME[locale][day]}
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            rows.map((start) => (
              <tr data-time-row={start}>
                <th scope="row" class="gutter">
                  <time datetime={formatTime(start)}>{formatTime(start)}</time>
                </th>
                {columns.map((day) => (
                  <td>
                    {entriesAt(entries, day, start).map((entry) => (
                      <div class="block" data-slot data-level={entry.level}>
                        <span class="blockName">{entry.name[locale]}</span>
                        <span class="blockMeta">
                          <span data-level-name={entry.level}>
                            {LEVEL_NAME[locale][entry.level]}
                          </span>{' '}
                          · {formatNames(entry.instructors, locale)}
                        </span>
                        <span class="blockPrereq">
                          {LEVEL_PREREQUISITE[locale][entry.level]}
                        </span>
                      </div>
                    ))}
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .srOnly {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .hero {
    max-width: 1280px;
    margin-inline: auto;
    padding: var(--space-8) var(--space-5) var(--space-7);
  }
  @media (min-width: 768px) {
    .hero {
      padding: var(--space-10) var(--space-7) var(--space-8);
    }
  }

  /*
    Design system §7.2 asks for an `.invert` band in the dark theme when the
    schedule is the page's primary content, and explicitly *not* in light, where
    the page is already cream. The repo's `.invert` is unconditional, so honouring
    that literally would mean a component redeclaring role tokens per theme —
    exactly what §2 centralises to prevent. `--surface-sunken` gives the long
    table its relief in both themes with no new machinery. Noted as a deviation.
  */
  .band {
    background: var(--surface-sunken);
    padding: var(--space-7) var(--space-5) var(--space-8);
  }
  @media (min-width: 1024px) {
    .band {
      padding: var(--space-8) var(--space-7) var(--space-10);
    }
  }

  .wrap {
    max-width: 1280px;
    margin-inline: auto;
  }

  .eyebrow {
    font-family: var(--font-label);
    font-weight: 300;
    font-size: 0.75rem;
    letter-spacing: 0.32em;
    /* Č Ć Ž Š carry marks above the cap line — 1.4 is the floor in Croatian (§4.6) */
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0;
    max-width: none;
  }

  /* Cormorant, so never below 26px — `clamp()`'s first value is the floor (§4). */
  .display {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.75rem, 8vw, 5.5rem);
    line-height: 0.96;
    letter-spacing: -0.02em;
    text-wrap: balance;
    margin: var(--space-4) 0 0;
  }
  .lede {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--text-muted);
    margin-top: var(--space-5);
  }

  .empty {
    font-size: 1rem;
    color: var(--text-muted);
    padding: var(--space-6) 0;
    margin: 0;
  }

  /* --- which layout is on screen --- */
  .gridWrap {
    display: none;
  }
  @media (min-width: 768px) {
    .accordion {
      display: none;
    }
    .gridWrap {
      display: block;
      /* Last resort between 768px and ~900px, where five day columns plus the
         time gutter can out-measure the viewport. The page itself never scrolls
         sideways; this box does. */
      overflow-x: auto;
    }
  }

  /* --- accordion (< 768px) --- */
  .day {
    border-top: 1px solid var(--line);
  }
  .day:last-of-type {
    border-bottom: 1px solid var(--line);
  }
  .day summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    /* 44px minimum tap target, §11.3 */
    min-height: 44px;
    padding: var(--space-4) 0;
    list-style: none;
    cursor: pointer;
  }
  .day summary::-webkit-details-marker {
    display: none;
  }
  .dayName {
    font-family: var(--font-label);
    font-size: 0.8125rem;
    letter-spacing: 0.28em;
    line-height: 1.4;
    text-transform: uppercase;
  }
  .daySide {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex: none;
  }
  .dayCount {
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  .chev {
    width: 7px;
    height: 7px;
    border-right: 1px solid var(--accent);
    border-bottom: 1px solid var(--accent);
    transform: rotate(45deg) translate(-2px, -2px);
    transition: transform var(--dur-base) var(--ease);
  }
  .day[open] .chev {
    transform: rotate(-135deg) translate(-3px, -3px);
  }

  .slots {
    list-style: none;
    padding: 0 0 var(--space-5);
  }
  .slot {
    display: flex;
    gap: var(--space-4);
    padding: var(--space-3) 0;
    border-top: 1px solid var(--line);
  }
  .slot:first-child {
    border-top: 0;
  }
  /* The reference bundle sets this at 1.25rem; Cormorant's floor is 26px, below
     which the đ crossbar disappears — so 1.625rem, the display-s floor (§4).

     No `font-variant-numeric` here. Lining + tabular figures are inherited from
     the document (`src/styles/base.css`, MUSE-14); redeclaring the property here
     would replace that value rather than add to it, and `19:00` would go back to
     reading `I9:OO` with the column still perfectly aligned. */
  .slotTime {
    flex: none;
    width: 4.5rem;
    font-family: var(--font-display);
    font-size: 1.625rem;
    line-height: 1.15;
    color: var(--accent);
  }
  .slotBody {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .slotName {
    font-size: 1rem;
  }
  .slotMeta {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }
  /* Prerequisites are stated per class rather than once in a legend: the person
     who needs to know "about a year of dancing" is reading one row, not the key. */
  .slotPrereq {
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin-top: var(--space-1);
  }

  /* --- day × time grid (>= 768px) --- */
  .grid {
    width: 100%;
    border-collapse: collapse;
    /* Columns size to the content, not to equal fractions, so Ponedjeljak and
       Subota get the width each needs — §10 forbids fixed widths in Croatian. */
    table-layout: auto;
  }
  .dayHead,
  .gutterHead {
    font-family: var(--font-label);
    font-weight: 400;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--accent);
    text-align: left;
    /* Left padding 0 so a day header sits flush with the blocks in its column. */
    padding: 0 var(--space-3) var(--space-4) 0;
    vertical-align: bottom;
    white-space: nowrap;
  }
  .gutter {
    font-weight: 400;
    text-align: left;
    vertical-align: top;
    padding: var(--space-3) var(--space-4) var(--space-3) 0;
    border-top: 1px solid var(--line);
    white-space: nowrap;
  }
  /* Figures are inherited, not set here — see `.slotTime` above and MUSE-14. */
  .gutter time {
    font-family: var(--font-display);
    font-size: 1.625rem;
    line-height: 1.15;
    color: var(--accent);
  }
  .grid td {
    vertical-align: top;
    padding: var(--space-2) var(--space-2) var(--space-4) 0;
    border-top: 1px solid var(--line);
  }

  /* §7.2: classes as raised blocks with a 2px accent left border. No shadow —
     depth in this system is surface value plus hairlines (§5). */
  /*
    `max-width` because the week got shorter (MUSE-36). The grid is `width: 100%` and
    the real timetable has two day columns instead of five, so a block that filled its
    cell stretched to ~600px for three short lines and read as a banner rather than a
    class. The cap is a measure, not a fixed width — §10 forbids those, and Croatian
    runs 20–25% longer than English — so a longer class name still grows the block up to
    this point and then wraps.
  */
  .block {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 7rem;
    max-width: 26rem;
    padding: var(--space-3);
    background: var(--surface-raised);
    border-left: 2px solid var(--accent);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }
  .blockName {
    font-size: 0.9375rem;
  }
  .blockMeta {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }
  .blockPrereq {
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--text-muted);
  }

</style>
