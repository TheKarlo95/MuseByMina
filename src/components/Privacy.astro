---
import { FORM_HAS_PROCESSOR } from '../lib/forms';
import { localeUrl, type Locale } from '../lib/i18n';
import { getSiteSettings } from '../lib/sanity';

/**
 * `/privacy` — the notice the trial form has to be able to link to.
 *
 * Deliberately small, and deliberately not in the nav: it is a footnote the form points
 * at, not a destination. It exists because the form asks for a name, an email address and
 * a phone number, which is personal data under the GDPR whether or not this site stores
 * any of it — an inbox is processing, and the studio is in Zagreb.
 *
 * It describes what the site actually does, not what a template says a privacy policy
 * says: no analytics, no cookies, one inbox, and a form provider only if one is
 * configured. If any of that changes, this page changes with it.
 *
 * ---
 *
 * **MUSE-72 — three things this notice asserted that were not true, and what replaced
 * them.** Accuracy beats completeness in a statutory document, everywhere the two
 * conflict, so each of the three was replaced by the narrower claim that is defensible
 * rather than by a better guess.
 *
 *   1. **AZOP's address.** It said „Selska cesta 136" — correct when written, wrong since
 *      the Agency moved in May 2025. See `AZOP` below for the current one, where it was
 *      read, and when.
 *   2. **A processor that does not exist.** It named Formspark as the studio's processor,
 *      claimed an Art. 28 agreement and said Formspark emailed the messages through, with
 *      the endpoint unset and MUSE-12 recording that the form has never delivered a
 *      message. The recipient paragraphs are now chosen by `FORM_HAS_PROCESSOR` — the
 *      same configuration the form itself reads — so the notice and the form cannot
 *      disagree. The flat „nema prijenosa u treću zemlju" is gone outright: Formspark's
 *      own sub-processor list names Sentry and Mapbox in the US, so it was the site
 *      asserting something the processor declines to assert.
 *   3. **Retention.** „12 mjeseci" and „evidencija polaznika" were enforceable
 *      commitments nobody had made, and inventing a replacement number would have been
 *      the same mistake with a different digit. What is published is purpose limitation
 *      and the erasure right, both of which are true without a policy decision.
 *
 * **Still outstanding, and Mina's to make — not engineering's:** how long an answered
 * enquiry is kept, and whether student records exist as a system at all. Until she says,
 * this notice must stay silent on both. Both „Koliko dugo ih čuvamo" sections carry the
 * same note; if a specific period ever has to go in, it goes in there, beside the reason
 * it was chosen and whoever chose it.
 */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

/**
 * **Why this notice is in code and not in Sanity** (MUSE-72, weighing MUSE-50).
 *
 * MUSE-50's argument transfers at first glance: a regulator's address and a provider's
 * name are facts about the world that change without anyone touching this repository, and
 * the street went into the CMS for exactly that reason. It was weighed and declined, for
 * three reasons that are about this document rather than about CMSes.
 *
 * **A CMS field would move the staleness, not remove it.** `siteSettings.address` is
 * watched — `test/contentdrift.test.ts` can check it because five surfaces render one
 * field and must agree. AZOP's address has no second surface: there is nothing on this
 * site, or in the dataset, that a test could compare it against, and the suite never
 * touches the network. So moving it buys editability at the price of review and gains no
 * watchability at all. What it can have is provenance — a dated source, below — which a
 * reviewer sees on every diff and a Studio field does not carry.
 *
 * **The fact that genuinely varies is already in configuration, and configuration is a
 * better home than a CMS field.** Whether a processor exists is `FORM_HAS_PROCESSOR`,
 * which the form reads too, so the notice and the form are one fact. A Studio checkbox
 * beside it would be a third place to keep in step and the first one able to contradict
 * the running code.
 *
 * **And a legal notice Mina can edit is a legal notice Mina can break.** Not a hypothesis
 * here: the two claims this ticket deleted were a retention period and a records system
 * nobody had decided on, and a `required()` CMS field asking for a retention period can
 * only be satisfied by writing a number down — which is MUSE-36's lesson, in the one
 * document where the invented value is enforceable against the studio.
 *
 * So: structure and wording in code, reviewed, with a git history; the studio's own
 * contact details from Sanity, because they are shared with five other surfaces; and the
 * one varying fact from the configuration the form already reads.
 */
const settings = await getSiteSettings();

/**
 * **The supervisory authority, and when its address was last read off `azop.hr`.**
 *
 * Checked at `https://azop.hr/kontakt/` on 2026-10-09, which gives *"Ulica Metela
 * Ožegovića 16, HR – 10 000 Zagreb"*. The Agency has moved twice in the life of this
 * kind of notice — Martićeva 14, then Selska cesta 136 (Dec 2019), then here (May 2025)
 * — and MUSE-72 was filed because the page was one move behind and nothing noticed.
 *
 * No test can verify this: the suite never touches the network, and there is no second
 * surface to compare it against. The date is therefore the whole of the guard — it is
 * what lets a reviewer see how old the claim is instead of assuming somebody checked.
 * **Re-read the page and move the date when you touch this.**
 */
const AZOP = {
  street: 'Ulica Metela Ožegovića 16',
  city: '10 000 Zagreb',
  checked: '2026-10-09',
} as const;
const AZOP_ADDRESS = `${AZOP.street}, ${AZOP.city}`;

const t = {
  hr: {
    eyebrow: 'Kratko i bez pravnog žargona',
    h1: 'Izjava o privatnosti',
    lede:
      'Ova stranica nema analitiku, nema reklamne skripte i ne postavlja kolačiće. Jedini osobni podaci koje primamo su oni koje sama ili sam upišeš u obrazac za probni sat.',
    sections: [
      {
        h: 'Tko obrađuje podatke',
        p: [
          `${settings.studioName}, ${settings.address}, Hrvatska. Za svako pitanje o podacima dovoljan je e-mail na ${settings.email}.`,
        ],
      },
      {
        h: 'Što prikupljamo i zašto',
        p: [
          'Obrazac za probni sat traži ime, e-mail adresu i — ako ih želiš dati — broj telefona, razinu i poruku. Koristimo ih isključivo da ti odgovorimo i dogovorimo termin.',
          'Pravna osnova je priprema ugovora o usluzi na tvoj zahtjev i naš legitimni interes da odgovorimo na upit (čl. 6. st. 1. toč. b i f GDPR-a). Nema kvačice za privolu: privola koju ne možeš odbiti i ipak dobiti odgovor nije prava privola.',
          'Podatke ne koristimo za newsletter, ne profiliramo i ne donosimo automatizirane odluke.',
        ],
      },
      {
        h: 'Kome se podaci prenose',
        p: FORM_HAS_PROCESSOR
          ? [
              'Obrazac za nas prenosi vanjska usluga, koja pri tome djeluje kao izvršitelj obrade i poruku nam dostavlja e-mailom. Nakon toga poruka živi samo u našem poštanskom sandučiću. Drugih primatelja nema — ne prodajemo i ne dijelimo podatke.',
              'Takva usluga može koristiti podizvođače i izvan Europskog gospodarskog prostora. Ako se podaci prenesu izvan EGP-a, prijenos se temelji na standardnim ugovornim klauzulama Europske komisije (čl. 46. GDPR-a).',
            ]
          : [
              'Nikome. Obrazac trenutačno nije povezan ni s jednom vanjskom uslugom, pa tvoji podaci ne odlaze trećoj strani — ni u Hrvatskoj ni izvan nje.',
              `Zato ti obrazac, kad ga pokušaš poslati, umjesto potvrde ponudi našu e-mail adresu: prijavu nam pošalji na ${settings.email} i poruka dolazi izravno u naš poštanski sandučić. U njemu i ostaje. Ne prodajemo i ne dijelimo podatke.`,
            ],
      },
      // **Mina's decision, outstanding** (MUSE-72): how long an answered enquiry is kept,
      // and whether student records exist as a system. Purpose limitation and the erasure
      // right are all that can be published without her — both true, both already
      // promised elsewhere on this page. A number here would be enforceable against the
      // studio, so do not add one until she has given it.
      {
        h: 'Koliko dugo ih čuvamo',
        p: [
          'Ime, e-mail adresu, broj telefona i poruku koristimo samo da ti odgovorimo i dogovorimo termin. Čuvamo ih dok su za tu svrhu potrebni i ne dulje od toga.',
          `Brisanje možeš zatražiti u svakom trenutku — dovoljan je e-mail na ${settings.email}.`,
        ],
      },
      {
        h: 'Tvoja prava',
        p: [
          'Imaš pravo na pristup svojim podacima, ispravak, brisanje, ograničenje obrade, prigovor na obradu i prenosivost. Dovoljan je e-mail na ' +
            `${settings.email} i odgovaramo u roku od mjesec dana.`,
          `Ako misliš da s podacima postupamo pogrešno, možeš se obratiti Agenciji za zaštitu osobnih podataka (AZOP), ${AZOP_ADDRESS}.`,
        ],
      },
      {
        h: 'Kolačići i lokalna pohrana',
        p: [
          'Kolačića nema. Tvoj odabir teme (svijetlo/tamno) i jezika pamti se u lokalnoj pohrani tvojeg preglednika, ostaje na tvojem uređaju i nikada ne dolazi do nas. Zato ova stranica i nema prozorčić za kolačiće.',
        ],
      },
    ],
    back: 'Natrag na prijavu',
  },
  en: {
    eyebrow: 'Short, and without the legal padding',
    h1: 'Privacy notice',
    lede:
      'This site has no analytics, no advertising scripts and sets no cookies. The only personal data we receive is what you type into the trial-class form.',
    sections: [
      {
        h: 'Who processes the data',
        p: [
          `${settings.studioName}, ${settings.address}, Croatia. For anything at all about your data, an email to ${settings.email} is enough.`,
        ],
      },
      {
        h: 'What we collect, and why',
        p: [
          'The trial-class form asks for a name, an email address and — if you care to give them — a phone number, a level and a message. We use them only to reply and arrange a time.',
          'The lawful basis is taking steps towards a service agreement at your request, together with our legitimate interest in answering an enquiry (GDPR Art. 6(1)(b) and (f)). There is no consent tick-box: a box you cannot decline and still get an answer is not consent.',
          'We do not use the data for a newsletter, we do not profile you, and no decision is made about you automatically.',
        ],
      },
      {
        h: 'Who the data is passed to',
        p: FORM_HAS_PROCESSOR
          ? [
              'The form is delivered for us by an external service, which acts as our processor in doing so and emails the message to us. After that it lives only in our inbox. There are no other recipients — we do not sell or share it.',
              'A service of that kind may use sub-processors outside the European Economic Area. If data is transferred outside the EEA, the transfer relies on the European Commission’s standard contractual clauses (GDPR Art. 46).',
            ]
          : [
              'Nobody. The form is not currently connected to any external service, so nothing you type is passed to a third party — in Croatia or anywhere else.',
              `That is why the form, when you try to send it, offers you our email address instead of a confirmation: write to ${settings.email} and the message reaches our inbox directly. It stays there. We do not sell or share it.`,
            ],
      },
      // The HR half of this section carries the note: the retention period and whether
      // student records exist are Mina's outstanding decisions (MUSE-72).
      {
        h: 'How long we keep it',
        p: [
          'We use your name, email address, phone number and message only to reply and arrange a time. We keep them for as long as that purpose needs and no longer.',
          `You can ask us to delete them at any time — an email to ${settings.email} is enough.`,
        ],
      },
      {
        h: 'Your rights',
        p: [
          `You have the right of access, and to rectification, erasure, restriction, objection and portability. An email to ${settings.email} is enough, and we answer within one month.`,
          `If you think we are handling your data badly, you can complain to the Croatian Personal Data Protection Agency (AZOP), ${AZOP_ADDRESS}.`,
        ],
      },
      {
        h: 'Cookies and local storage',
        p: [
          'There are no cookies. Your theme (light/dark) and language choices are remembered in your browser’s local storage; they stay on your device and never reach us. That is why this site has no cookie banner.',
        ],
      },
    ],
    back: 'Back to the form',
  },
}[locale];
---

<section class="hero">
  <p class="eyebrow">{t.eyebrow}</p>
  <h1 class="display">{t.h1}</h1>
  <p class="lede">{t.lede}</p>
</section>

<section class="section">
  <div class="wrap">
    {
      t.sections.map((section) => (
        <div class="block">
          <h2 class="h">{section.h}</h2>
          {section.p.map((paragraph) => (
            <p class="body">{paragraph}</p>
          ))}
        </div>
      ))
    }

    <a class="back" href={localeUrl('/contact', locale)}>{t.back}</a>
  </div>
</section>

<style>
  .hero {
    max-width: 1280px;
    margin-inline: auto;
    padding: var(--space-8) var(--space-5) var(--space-6);
  }
  @media (min-width: 768px) {
    .hero {
      padding: var(--space-10) var(--space-7) var(--space-7);
    }
  }

  .section {
    padding: 0 var(--space-5) var(--space-8);
  }
  @media (min-width: 768px) {
    .section {
      padding: 0 var(--space-7) var(--space-10);
    }
  }
  .wrap {
    max-width: 1280px;
    margin-inline: auto;
  }

  .eyebrow {
    font-family: var(--font-label);
    font-weight: 300;
    font-size: 0.75rem;
    letter-spacing: 0.32em;
    /* Č Ć Ž Š carry marks above the cap line — 1.4 is the floor in Croatian (§4.6) */
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0;
    max-width: none;
  }

  .display {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.02em;
    text-wrap: balance;
    margin: var(--space-4) 0 0;
  }

  .lede {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--text-muted);
    margin-top: var(--space-5);
    max-width: 62ch;
  }

  .block {
    padding-top: var(--space-6);
    margin-top: var(--space-6);
    border-top: 1px solid var(--line);
  }
  .h {
    font-family: var(--font-label);
    font-size: 0.75rem;
    letter-spacing: 0.28em;
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--accent);
  }
  .body {
    margin-top: var(--space-4);
    line-height: 1.7;
    color: var(--text-muted);
  }

  .back {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: var(--space-7);
    font-family: var(--font-label);
    font-size: 0.8125rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    text-underline-offset: 4px;
  }
</style>
