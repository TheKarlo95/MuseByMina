---
import { Image } from 'astro:assets';

import { PRIMARY_NAV, MORE_NAV, CTA } from '../lib/nav';
import { localeUrl, routeKey, type Locale } from '../lib/i18n';
import {
  iconClearSpace,
  MASTHEAD_MARK_EMITTED,
  MASTHEAD_MARK_HEIGHT,
} from '../lib/icon';
import mark from '../assets/icon/muse-mark-white.png';
import LocaleSwitch from './LocaleSwitch.astro';
import ThemeSwitch from './ThemeSwitch.astro';

interface Props {
  locale: Locale;
  /**
   * Does this page have a URL of its own, in both locales?
   *
   * False on the 404 (MUSE-13): GitHub Pages serves one root `404.html` for every
   * unknown path, so the page has no address — `/404/`, `/en/404` and `/en/404/` are
   * all themselves 404s. The language switcher is a prefix swap on the current route,
   * which makes it two dead links on the one page a visitor reaches *because* a link
   * was dead.
   *
   * `BaseLayout` passes `localeTwin`, which is this question and only this one. It used to
   * pass `indexable` — true of every page here, and a claim about crawlers — which also
   * took `langInitScript` off the error page and so discarded a `?lang=` that was meant to
   * work everywhere (MUSE-38).
   */
  localeSwitch?: boolean;
}
const { locale, localeSwitch = true } = Astro.props;

const here = routeKey(Astro.url.pathname);

/** §12's clear space for the mark at the size this band draws it. See `src/lib/icon.ts`. */
const markClear = iconClearSpace(MASTHEAD_MARK_HEIGHT);
const t = {
  menu: locale === 'hr' ? 'Izbornik' : 'Menu',
  more: locale === 'hr' ? 'Više' : 'More',
  home: locale === 'hr' ? 'Muse by Mina — početna' : 'Muse by Mina — home',
};
---

<header class="header" data-header>
  <div class="inner">
    {/*
      **The icon-only mark, which is what §12 names for this surface** (MUSE-67).

      The lockup cannot be here and never could: §12's minimum reproduction size for it
      is 100px wide, the artwork is 1.372:1, so the smallest legible lockup is 73px tall
      against a 64px band (§7.1) — and 121px tall once §12's clear space is added, which
      does not fit the 80px desktop band either. The arithmetic is in `logo/README.md`
      and the constants it runs on are in `src/lib/lockup.ts` and `src/lib/icon.ts`.

      Until MUSE-40 the fallback was two spans of live type, which §12 forbids by name,
      registered as the single exemption in `test/lockup.test.ts`. MUSE-40 shipped the
      mark — a crop of the same lockup — and §12's variants table names it for exactly
      this surface. 36px tall is 27px wide against §12's 24px floor, with 12px of clear
      space, so the whole envelope is 60px in a 64px band.

      `alt=""` is deliberate: the link owns the accessible name. Two names on one link
      is read as a repetition by some combinations and as a sentence by others, and the
      criterion is „exactly once".
    */}
    <a
      class="logo"
      href={localeUrl('/', locale)}
      aria-label={t.home}
      style={`--mark-height:${MASTHEAD_MARK_HEIGHT}px;--mark-clear:${markClear}px`}
    >
      <Image
        src={mark}
        alt=""
        width={MASTHEAD_MARK_EMITTED.width}
        height={MASTHEAD_MARK_EMITTED.height}
        format="webp"
        quality={80}
        loading="eager"
        decoding="async"
      />
    </a>

    <button
      class="menuBtn"
      type="button"
      aria-controls="primary-nav"
      aria-expanded="false"
      data-menu-btn
    >
      <span class="srOnly">{t.menu}</span>
      <span class="bars" aria-hidden="true"></span>
    </button>

    <nav id="primary-nav" class="nav" data-nav aria-label={t.menu}>
      <ul class="navList">
        {
          PRIMARY_NAV.map((item) => (
            <li class:list={['navItem', item.mobileOnly && 'mobileOnly']}>
              <a
                href={localeUrl(item.route, locale)}
                aria-current={here === item.route ? 'page' : undefined}
              >
                {item.label[locale]}
              </a>
            </li>
          ))
        }

        {/*
          The disclosure exists only when there is something to disclose (MUSE-13).
          `MORE_NAV` is empty while the content pages are unbuilt, and a "More" button
          that opens an empty list is worse than no button: it is a visible affordance
          that promises the rest of the site and delivers nothing, and for a screen
          reader an `aria-expanded` control over an empty `<ul>` is a dead end rather
          than a disappointment. The button and the menu come back with the first entry.
        */}
        {MORE_NAV.length > 0 && (
          <li class="navItem hasMore">
            {/*
              A real disclosure, not a hover trap. axcentdance's "More" is hover-only on
              a button with no aria-expanded and no key handling, so keyboard and touch
              users simply cannot open it. Click/Enter/Space opens; Escape closes; hover
              is only an enhancement layered on top.
            */}
            <button
              class="moreBtn"
              type="button"
              aria-controls="more-menu"
              aria-expanded="false"
              data-more-btn
            >
              {t.more}
              <span class="chev" aria-hidden="true"></span>
            </button>
            <ul id="more-menu" class="moreMenu" data-more-menu hidden>
              {MORE_NAV.map((item) => (
                <li>
                  <a
                    href={localeUrl(item.route, locale)}
                    aria-current={here === item.route ? 'page' : undefined}
                  >
                    {item.label[locale]}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        )}
      </ul>

      <div class="chrome">
        <a class="cta" href={localeUrl(CTA.route, locale)}>{CTA.label[locale]}</a>
        {localeSwitch && <LocaleSwitch locale={locale} />}
        <ThemeSwitch locale={locale} />
      </div>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const menuBtn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const moreBtn = document.querySelector<HTMLButtonElement>('[data-more-btn]');
  const moreMenu = document.querySelector<HTMLElement>('[data-more-menu]');

  // Densify on scroll rather than starting transparent over the hero — avoids the
  // contrast bug that a transparent-over-photography header always invites.
  const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 50);
  onScroll();
  addEventListener('scroll', onScroll, { passive: true });

  const setMenu = (open: boolean) => {
    menuBtn?.setAttribute('aria-expanded', String(open));
    nav?.classList.toggle('open', open);
    document.body.style.overflow = open ? 'hidden' : '';
  };

  const setMore = (open: boolean) => {
    moreBtn?.setAttribute('aria-expanded', String(open));
    if (moreMenu) moreMenu.hidden = !open;
  };

  menuBtn?.addEventListener('click', () =>
    setMenu(menuBtn.getAttribute('aria-expanded') !== 'true'),
  );
  moreBtn?.addEventListener('click', () =>
    setMore(moreBtn.getAttribute('aria-expanded') !== 'true'),
  );

  // Closing returns focus to the control that opened it, so keyboard users aren't
  // dumped at the top of the document.
  addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (moreBtn?.getAttribute('aria-expanded') === 'true') {
      setMore(false);
      moreBtn.focus();
    } else if (menuBtn?.getAttribute('aria-expanded') === 'true') {
      setMenu(false);
      menuBtn.focus();
    }
  });

  document.addEventListener('click', (e) => {
    const target = e.target as Node;
    if (moreBtn && moreMenu && !moreBtn.contains(target) && !moreMenu.contains(target)) {
      setMore(false);
    }
    if ((target as HTMLElement).closest?.('[data-nav] a')) setMenu(false);
  });
</script>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    /* Opaque in BOTH themes. A translucent band composites plum-ink over cream in
       the light theme (#594553), which drops gold to 3.88:1 and fails AA — caught by
       the a11y gate. Translucency only works over hero photography with a scrim;
       revisit when that imagery exists. */
    background: var(--band-surface);
    border-bottom: 1px solid transparent;
    transition:
      background var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }
  .header.scrolled {
    border-bottom-color: var(--band-line);
  }

  .inner {
    max-width: 1280px;
    margin-inline: auto;
    padding: 0 var(--space-5);
    height: 64px;
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }
  @media (min-width: 900px) {
    .inner {
      height: 80px;
      padding-inline: var(--space-7);
    }
  }

  /* The header band is --surface-deep in BOTH themes, so its contents are always
     the light-on-dark pairing — never theme-dependent. That is why the mark is the
     white variant on a light page too, with no `media` query and no second file:
     §12's `.logo-white` / `.logo-plum` utilities are for a logo on --surface. */
  .logo {
    display: block;
    margin-inline-end: auto;
    /* §12's clear space, on all four sides, derived from the drawn height in
       `src/lib/icon.ts` — a padding rather than a margin so a neighbour cannot collapse
       it. It also takes the home link from 27 × 36 to 51 × 60, which is the tap target
       §7.1 asks for and the typeset wordmark used to supply by being wide. */
    padding: var(--mark-clear);
    /* The leading edge borrows the band's own gutter, the way `Lockup.astro` does: the
       inner padding is 24px mobile / 48px desktop against a 12px requirement, so the
       space is already there and the mark aligns with the content below it instead of
       hanging 12px inside a column whose every other line starts at the edge. */
    margin-inline-start: calc(-1 * var(--mark-clear));
  }
  .logo img {
    display: block;
    /* Height-driven: the band is a height and the mark is portrait. The emitted
       width/height attributes carry the ratio, so `auto` restates nothing. */
    height: var(--mark-height);
    width: auto;
  }

  .srOnly {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .menuBtn {
    width: 44px;
    height: 44px;
    display: grid;
    place-content: center;
    border: 1px solid var(--band-line-accent);
    border-radius: var(--radius-full);
    background: transparent;
    cursor: pointer;
  }
  .bars,
  .bars::before,
  .bars::after {
    display: block;
    width: 16px;
    height: 1px;
    background: var(--band-accent);
    transition: transform var(--dur-fast) var(--ease);
  }
  .bars::before,
  .bars::after {
    content: '';
    position: relative;
  }
  .bars::before {
    top: -5px;
  }
  .bars::after {
    top: 4px;
  }
  [aria-expanded='true'] .bars {
    background: transparent;
  }
  [aria-expanded='true'] .bars::before {
    transform: translateY(5px) rotate(45deg);
  }
  [aria-expanded='true'] .bars::after {
    transform: translateY(-5px) rotate(-45deg);
  }
  @media (min-width: 900px) {
    .menuBtn {
      display: none;
    }
  }

  /* --- mobile panel --- */
  .nav {
    position: fixed;
    inset: 64px 0 0;
    background: var(--band-surface);
    padding: var(--space-6) var(--space-5) var(--space-8);
    overflow-y: auto;
    display: none;
    flex-direction: column;
    gap: var(--space-6);
  }
  .nav.open {
    display: flex;
  }

  .navList {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .navList a,
  .moreBtn {
    font-family: var(--font-display);
    font-size: 1.625rem;
    color: var(--band-text);
    text-decoration: none;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
  }
  .navList a[aria-current='page'] {
    color: var(--band-accent);
  }

  /* Must beat the `display: flex` below — otherwise [hidden] does nothing and the
     dropdown renders permanently open. */
  .moreMenu[hidden] {
    display: none;
  }

  .moreMenu {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-3) 0 0 var(--space-4);
    border-left: 1px solid var(--band-line);
    margin-top: var(--space-3);
  }
  .moreMenu a {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--band-muted);
  }

  .chev {
    width: 7px;
    height: 7px;
    border-right: 1px solid var(--band-accent);
    border-bottom: 1px solid var(--band-accent);
    transform: rotate(45deg) translate(-2px, -2px);
    transition: transform var(--dur-fast) var(--ease);
  }
  [aria-expanded='true'] > .chev {
    transform: rotate(-135deg) translate(-3px, -3px);
  }

  .chrome {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    margin-top: auto;
    padding-top: var(--space-5);
    border-top: 1px solid var(--band-line);
  }

  .cta {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding-inline: var(--space-6);
    border-radius: var(--radius-full);
    background: var(--band-accent);
    color: var(--band-fill-text);
    font-family: var(--font-label);
    font-size: 0.8125rem;
    letter-spacing: 0.28em;
    line-height: 1.4;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition:
      transform var(--dur-fast) var(--ease),
      filter var(--dur-fast) var(--ease);
  }
  .cta:hover {
    transform: translateY(-1px);
    filter: brightness(1.06);
  }

  /* --- desktop bar --- */
  @media (min-width: 900px) {
    .nav {
      position: static;
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: var(--space-5);
      background: none;
      padding: 0;
      overflow: visible;
      inset: auto;
    }
    .navList {
      flex-direction: row;
      align-items: center;
      gap: var(--space-5);
    }
    /* Entries flagged `mobileOnly` live only in the mobile panel — this is the whole
       trick. Today that is Home alone: the logo is the home link on desktop, which is
       true however long the list gets, and the bar is short enough that Contact earns
       its place in it. See `src/lib/nav.ts`. */
    .navItem.mobileOnly {
      display: none;
    }
    .navList a,
    .moreBtn {
      font-family: var(--font-label);
      font-size: 0.875rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      min-height: 0;
      white-space: nowrap;
    }
    .hasMore {
      position: relative;
    }
    .moreMenu {
      position: absolute;
      top: calc(100% + var(--space-4));
      left: 50%;
      translate: -50% 0;
      min-width: 240px;
      background: var(--band-surface);
      border: 1px solid var(--band-line-accent);
      border-radius: var(--radius-sm);
      padding: var(--space-4);
      margin: 0;
      gap: var(--space-2);
    }
    .moreMenu a {
      white-space: nowrap;
    }
    .chrome {
      margin: 0;
      padding: 0;
      border: 0;
      flex-wrap: nowrap;
      gap: var(--space-3);
    }
    .cta {
      min-height: 52px;
      font-size: 0.75rem;
      letter-spacing: 0.2em;
      padding-inline: var(--space-5);
    }
  }
</style>
