<script>
  /**
   * **The hero video, and the one decision CSS cannot make** (MUSE-133).
   *
   * `prefers-reduced-motion: reduce` is answered once, globally, in
   * `src/styles/base.css` — and what it answers there is `animation`, `transition` and
   * `scroll-behavior`. A playing `<video>` is none of those: no stylesheet can pause it.
   * So this is not a second copy of that decision, it is the half of it that has to be
   * script, and it is written here rather than in a component stylesheet for exactly that
   * reason. Design system §8: *"disable video autoplay and show the poster with a play
   * control."*
   *
   * Which is also why the element carries no `autoplay` attribute. With one, a visitor who
   * has asked for less motion gets a frame or two of it before any script runs; without
   * one, playback is something this file decides.
   *
   * **`preload="none"` is load-bearing and was measured** (MUSE-133). It was `auto` first,
   * so that the browser fetched the file whether or not anything played it and the
   * performance budget could keep weighing it. What that produced, with scripting off, is
   * a media request nobody ever consumes: Chromium opens it, suspends it, and the page
   * reaches `networkidle` only sometimes — four identical loads of `/` with JavaScript
   * disabled timed out three times at 30 s, which `test/trialform.test.ts`'s no-script
   * cases found first. With `none`, a page with no scripting asks for no video at all and
   * shows the poster, which is what §7.4 requires the poster to be good for; `play()`
   * below is what fetches it, so the budget still measures the whole file at both
   * viewports — `npm run budget`'s `media` column says 1,250 KB on `/`, and a zero there
   * is the signal that this went wrong again.
   *
   * The control is real either way: a visitor who wants the loop stopped, or started, can
   * do it, and the label follows the state rather than being announced once.
   */
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-hero-toggle]');

  if (video && toggle) {
    const { play = '', pause = '' } = toggle.dataset;

    const show = (playing: boolean) => {
      toggle.setAttribute('aria-pressed', String(playing));
      toggle.setAttribute('aria-label', playing ? pause : play);
    };

    const calm = window.matchMedia('(prefers-reduced-motion: reduce)');

    const start = () => {
      // `play()` rejects when the browser declines to autoplay — a muted, inline video is
      // normally allowed, but the poster staying put is the correct outcome either way, so
      // the state follows what actually happened rather than what was asked for.
      video.play().then(
        () => show(true),
        () => show(false),
      );
    };

    if (calm.matches) show(false);
    else start();

    // A visitor who turns reduced motion on while the page is open gets the same answer as
    // one who had it on when it loaded.
    calm.addEventListener('change', (event) => {
      if (!event.matches) return;
      video.pause();
      show(false);
    });

    toggle.addEventListener('click', () => {
      if (video.paused) start();
      else {
        video.pause();
        show(false);
      }
    });
  }
</script>
