---
import TrialForm from './TrialForm.astro';
import { localeUrl, type Locale } from '../lib/i18n';
import { CTA, STUDIO } from '../lib/nav';
import {
  formatTime,
  groupByDay,
  LEVEL_NAME,
  LEVEL_PREREQUISITE,
  minutesPhrase,
  uniformDuration,
  WEEKDAY_NAME,
  type ClassEntry,
  type Level,
} from '../lib/schedule';

interface Props {
  locale: Locale;
  /**
   * The studio's address, from Sanity — passed in rather than read here, and that is not
   * a style preference.
   *
   * Astro orders a page's stylesheets by the order it crawls the page's imports, and this
   * component's own `<style>` is inlined while `TrialForm`'s is an external `<link>`.
   * Adding *any* import to this file — above `TrialForm`, below it, anywhere — moves the
   * inlined block past both `<link>`s in `<head>` on `/` and `/en`. Nothing renders
   * differently (both are scoped), but MUSE-20's acceptance test is a byte-for-byte
   * `diff -r` of the built site against the previous deploy, and a moved `<style>` is a
   * byte. Measured, not assumed: three placements, three identical diffs.
   *
   * `src/pages/index.astro` already reads the CMS for its `<title>`, so it hands the
   * address down and this file's import list stays exactly as it was. `Contact.astro`
   * reads directly because it has the same exposure but survives it at one specific
   * import position — see the note there.
   */
  address: string;
  /**
   * The weekly timetable, from `getSchedule()` — the same rows `/schedule` renders.
   *
   * A prop for the reason `address` is a prop: this file's import list cannot grow. It
   * also closes MUSE-11's door from the other side — the doors are derived from the
   * schedule, and the schedule now arrives from the CMS, so the homepage cannot advertise
   * a class the timetable does not have even for one build.
   */
  entries: ClassEntry[];
  /**
   * **The hero's video and its poster, as URLs the wrapper imported** (MUSE-133).
   *
   * Same rule as everything above, and it is the reason these are strings rather than an
   * `import` here: `import hero from '../assets/hero.webm?url'` is an import, and this
   * file's import list cannot grow. The page wrappers own both imports, so Vite still
   * emits the content-hashed asset and the base prefix is still applied at build time —
   * which is the half `public/` plus a hand-written path gets wrong (MUSE-35).
   */
  hero: { video: string; poster: string };
  /**
   * The studio story — `studioStory`, already resolved to this page's locale.
   *
   * Resolved by the wrapper rather than handed over whole, for the import rule again:
   * the locale pick is `story.heading[locale]`, which needs no type from the read path.
   * The words are Mina's and are placeholder prose in the dataset until she types over
   * them (MUSE-60); nothing here describes the studio.
   */
  story: { heading: string; paragraphs: string[] };
  /**
   * The rate card — every `pricingTier`, formatted by `src/lib/pricing.ts` in the wrapper.
   *
   * Formatted there and not here for two reasons: the import rule, and the rule that
   * currency formatting is code (`formatPrice`, `periodName`) rather than something each
   * surface spells its own way. **No price is written in this file** — `/pricing` is the
   * page that publishes the rate card (MUSE-73), and this is the same three documents.
   */
  rates: { name: string; price: string; period: string }[];
  /**
   * Who teaches — `instructor`, name and role, resolved by the wrapper.
   *
   * Name and role are the whole of it. `portrait` and `bio` are optional because no real
   * value exists for them, and a `required()` field with no value can only be filled with
   * fiction, which is how MUSE-36 happened.
   */
  people: { name: string; role: string }[];
}
const { locale, address, entries, hero, story, rates, people } = Astro.props;

/** As on `/schedule`: the class length is read off the rows, never typed (MUSE-36). */
const minutes = uniformDuration(entries);

const t = {
  hr: {
    eyebrow: 'Plesni studio · Zagreb',
    h1: 'Nauči bachatu u Zagrebu',
    lede: [
      'Bez partnera, bez iskustva.',
      minutes === undefined
        ? 'Razinu biraš po tome koliko dugo plešeš.'
        : `Satovi traju ${minutesPhrase(minutes, 'hr')}, a razinu biraš po tome koliko dugo plešeš.`,
    ].join(' '),
    schedule: 'Pogledaj raspored',
    startHere: 'Nova si u plesu?',
    startLede: 'Dvoja vrata, ne šest. Odaberi ono koje ti odgovara.',
    week: 'Tjedni raspored',
    weekLede: 'Kad se pleše',
    about: 'O studiju',
    aboutMore: 'Više o nama',
    rates: 'Cijene',
    ratesLede: 'Što košta',
    ratesMore: 'Cijeli cjenik',
    teachers: 'Tko predaje',
    where: 'Gdje smo',
    openMaps: 'Otvori u Google Maps',
    trial: 'Dođi na probni sat',
    // MUSE-71 removed this sentence's first half, which priced the first class at
    // nothing. The second half is the whole of what the studio has actually said.
    trialLede: 'Javi nam se i dogovorit ćemo termin.',
    playVideo: 'Pokreni video',
    pauseVideo: 'Zaustavi video',
    doorNudge: { beginner: 'Počni ovdje.' },
  },
  en: {
    eyebrow: 'Dance studio · Zagreb',
    h1: 'Learn bachata in Zagreb',
    lede: [
      'No partner, no experience needed.',
      minutes === undefined
        ? 'Pick your level by how long you have been dancing.'
        : `Classes run ${minutesPhrase(minutes, 'en')}, and you pick your level by how long you have been dancing.`,
    ].join(' '),
    schedule: 'See the schedule',
    startHere: 'New to dancing?',
    startLede: 'Two doors, not six. Pick the one that fits.',
    week: 'Weekly schedule',
    weekLede: 'When we dance',
    about: 'About the studio',
    aboutMore: 'More about us',
    rates: 'Prices',
    ratesLede: 'What it costs',
    ratesMore: 'The whole price list',
    teachers: 'Who teaches',
    where: 'Where we are',
    openMaps: 'Open in Google Maps',
    trial: 'Come to a trial class',
    trialLede: 'Get in touch and we will find you a slot.',
    playVideo: 'Play the video',
    pauseVideo: 'Pause the video',
    doorNudge: { beginner: 'Start here.' },
  },
}[locale];

/**
 * Widened on purpose: the nudge is written for the beginner door only, and a door
 * without one is correct rather than a missing translation. See the note on `doors`.
 */
const doorNudge: Partial<Record<Level, string>> = t.doorNudge;

/**
 * Which levels get a door. This list is the whole editorial decision, and the
 * only part of a door written on this page.
 *
 * **„Dvoja vrata, ne šest." is this page's line, not the design brief's**
 * (MUSE-80). The comment here used to cite the brief for it. The brief was then
 * read: it contains no „vrata", no "door" and no "not six", and its only six is
 * the six signature devices in §6. The words stay — they claim nothing about the
 * studio and they are in the register §1 asks for, short and unsold — but the
 * attribution is gone, because the next author would have trusted it instead of
 * opening the file, which is how a fabricated citation outlives fabricated copy.
 *
 * The decision the line describes is this page's own: the people who need telling
 * where to start are the one who has never danced and the one who is a year in.
 * Advanced dancers already know, so advanced deliberately has no door — which is
 * why this is a hand-picked pair of levels and not `LEVELS`.
 */
const DOOR_LEVELS = ['beginner', 'intermediate'] as const satisfies readonly Level[];

/**
 * There are four levels now and still two doors (MUSE-36).
 *
 * `improver` joined `LEVELS` with the real timetable, and it is deliberately *not* a
 * door: the reason for picking two was who needs telling where to start, and somebody a
 * few months in already knows they are not a beginner. A door per level would be four
 * doors, which is the direction the section's own lede rejects.
 */

/**
 * The class a door points at: the first session of that level in the week.
 *
 * MUSE-11 — the day and time used to be typed into this file, and had already
 * drifted: the intermediate door advertised Thursday 20:00, which is an
 * *advanced* class. So the session is derived rather than hand-picked, and a
 * schedule edit can no longer leave the homepage pointing at a class that is not
 * there. `groupByDay` is week-ordered and sorts each day by start time, so
 * "first" means the soonest in the week — the nearest way in.
 */
function firstSession(level: Level): ClassEntry | undefined {
  for (const group of groupByDay(entries)) {
    const entry = group.entries.find((candidate) => candidate.level === level);
    if (entry) return entry;
  }
  return undefined;
}

/**
 * Level name, prerequisite, day and time all come from the schedule; only the
 * **nudge** is page copy.
 *
 * ---
 *
 * **The door's „who is this for?" line is `LEVEL_PREREQUISITE`** (MUSE-18).
 *
 * It used to be a `doorWho` table in the copy block above, and
 * `doorWho.intermediate` was byte-identical to
 * `LEVEL_PREREQUISITE[locale].intermediate` in both languages — „Plešeš oko godinu
 * dana." / "About a year of dancing.". Exactly the drift MUSE-11 had just fixed for
 * the level *name*, one field over, on the same cards, and nothing watched it:
 * MUSE-11's guard only knew about `LEVEL_NAME`. The beginner entry was worse in a
 * quieter way — it said the same *fact* as the prerequisite in different words
 * („Nikad nisi plesao/la." vs „Bez iskustva — nikad nisi plesao ni plesala."), so
 * the homepage and `/schedule` already disagreed about what a beginner is, in a way
 * no diff would ever flag as a conflict.
 *
 * So the prerequisite is read, and `t.doorNudge` keeps only the part that is
 * genuinely this page's: „Počni ovdje." / "Start here.", which is a call to action
 * rather than a description of the level and belongs to the beginner door alone. A
 * door with no nudge renders the prerequisite by itself.
 *
 * `test/home.test.ts` now guards `LEVEL_PREREQUISITE` the same way it guards
 * `LEVEL_NAME`, so this cannot be pasted back.
 *
 * **A door onto a level nobody teaches is dropped, not a build failure** — and that
 * changed in MUSE-36, so the reasoning is worth having here.
 *
 * MUSE-11 threw: "a door onto a level nobody teaches is worse than one door fewer". That
 * was right while the rows were a file in this repository, where a missing beginner class
 * could only be a developer's mistake and a loud build failure was the cheapest way to
 * find it. The rows are CMS content now, and `scheduleSlot.active` exists precisely so
 * Mina can take a class off the timetable for the summer — so the same rule would mean a
 * legitimate edit in the Studio stops the site building, on every pull request and every
 * scheduled rebuild, with an error about a homepage door.
 *
 * What MUSE-11 was actually protecting is still protected: a door never shows a day and
 * time that is not in the schedule, because it has none to show unless there is a class.
 * The section going *empty* is still a build failure, below — "New to dancing?" with no
 * way in is a broken page rather than a smaller one.
 */
const doors = DOOR_LEVELS.flatMap((level) => {
  const entry = firstSession(level);
  if (!entry) return [];
  return [
    {
      level,
      name: LEVEL_NAME[locale][level],
      when: `${WEEKDAY_NAME[locale][entry.day]} · ${formatTime(entry.start)}`,
      who: [LEVEL_PREREQUISITE[locale][level], doorNudge[level]].filter(Boolean).join(' '),
    },
  ];
});

if (doors.length === 0) {
  throw new Error(
    `The homepage's „${t.startHere}" section has no doors: the schedule holds no ` +
      `${DOOR_LEVELS.join(' or ')} class. One of those two has to be on the timetable — ` +
      `check that their slots are switched on in the Studio.`,
  );
}

/**
 * **The week, in the order it happens** (MUSE-133).
 *
 * The same rows as the doors and as `/schedule`, flattened: `groupByDay` is week-ordered
 * and sorts each day by start time, so this is the timetable reading downwards. It is a
 * preview and not a second timetable — no instructor, no duration, no level description,
 * and `/schedule` is one link away — because two renderings of one dataset is how the
 * homepage drifted from the schedule in the first place (MUSE-11).
 */
const week = groupByDay(entries).flatMap((group) =>
  group.entries.map((entry) => ({
    level: entry.level,
    name: LEVEL_NAME[locale][entry.level],
    when: `${WEEKDAY_NAME[locale][group.day]} · ${formatTime(entry.start)}`,
  })),
);
---

{/*
  **The hero carries the studio's own footage** (MUSE-133).

  `aria-hidden` and an empty `alt`-equivalent: the video says nothing the copy does not,
  so it is decorative and stays out of the accessibility tree. The poster is required by
  design system §7.4 and has to look complete on its own — it is the first frame, so the
  swap when playback starts is invisible, and it is what a visitor sees when motion is
  not wanted.

  `<source>` rather than `src` on the element is deliberate: `assetRefs` in
  `test/helpers/build.ts` reads `<source>` and does not read `<video>`, so written this
  way the hero's URL is checked against both deploy targets like every other asset
  (MUSE-8). Written the other way it would be the one asset nothing checks.
*/}
<section class="hero">
  <video
    class="heroVideo"
    poster={hero.poster}
    muted
    loop
    playsinline
    preload="none"
    aria-hidden="true"
    data-hero-video
  >
    <source src={hero.video} type="video/webm" />
  </video>
  <div class="heroScrim" aria-hidden="true"></div>

  <div class="heroContent">
    <p class="eyebrow">{t.eyebrow}</p>
    <h1 class="display">{t.h1}</h1>
    <p class="lede">{t.lede}</p>
    <div class="actions">
      <a class="btn btnPrimary" href={localeUrl(CTA.route, locale)}>{CTA.label[locale]}</a>
      <a class="btn btnSecondary" href={localeUrl('/schedule', locale)}>{t.schedule}</a>
    </div>
  </div>

  <button
    class="heroToggle"
    type="button"
    data-hero-toggle
    data-play={t.playVideo}
    data-pause={t.pauseVideo}
    aria-label={t.playVideo}
  >
    <span class="heroToggleGlyph" aria-hidden="true"></span>
  </button>
</section>

<section class="section sunken">
  <div class="wrap">
    <div class="head">
      <p class="eyebrow">{t.startHere}</p>
      <h2 class="displayM">{t.startLede}</h2>
    </div>
    <ul class="cards two">
      {
        doors.map((d) => (
          <li class="card" data-door={d.level}>
            {/*
              `data-level-name` is the site-wide contract (MUSE-11): an element
              that shows a level's name declares which level it is, so the suite
              can check every one of them against `LEVEL_NAME` and compare this
              page against `/schedule` without matching on copy.
            */}
            <p class="cardName" data-level-name={d.level}>{d.name}</p>
            <p class="cardWhen" data-when>{d.when}</p>
            <p class="cardWho">{d.who}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="head">
      <p class="eyebrow">{t.week}</p>
      <h2 class="displayM">{t.weekLede}</h2>
    </div>
    <ul class="slots">
      {
        week.map((slot) => (
          <li class="slot">
            <p class="slotWhen">{slot.when}</p>
            <p class="slotName" data-level-name={slot.level}>{slot.name}</p>
          </li>
        ))
      }
    </ul>
    <div class="actions">
      <a class="btn btnSecondary" href={localeUrl('/schedule', locale)}>{t.schedule}</a>
    </div>
  </div>
</section>

{/*
  **„Tri okusa, jedan ples" was here, and nothing replaces it** (MUSE-36).

  Three cards — Traditional / Moderna / Sensual — each with a paragraph about what that
  style is like. It was the homepage's most substantial piece of writing and it described
  a distinction the studio does not make: the three styles were invented in the foundation
  commit alongside the thirteen invented classes, and the real timetable has no style
  dimension at all. Copy that is well written about something untrue is worse than no copy,
  because it reads as authoritative.

  What stands here now is the studio's own story, out of the CMS (MUSE-133) — the same
  `studioStory` document `/aboutus` renders, which is Mina's placeholder prose until she
  types over it and asserts nothing checkable. The section is hers to fill, which is what
  MUSE-36 asked for; it is not a paragraph written here about what a class is like.
*/}

<section class="section">
  <div class="wrap">
    <div class="head">
      <p class="eyebrow">{t.about}</p>
      <h2 class="displayM">{story.heading}</h2>
      {story.paragraphs.map((paragraph) => <p class="prose">{paragraph}</p>)}
    </div>
    <div class="actions">
      <a class="btn btnSecondary" href={localeUrl('/aboutus', locale)}>{t.aboutMore}</a>
    </div>
  </div>
</section>

<section class="section sunken">
  <div class="wrap">
    <div class="head">
      <p class="eyebrow">{t.rates}</p>
      <h2 class="displayM">{t.ratesLede}</h2>
    </div>
    <ul class="rates">
      {
        rates.map((rate) => (
          <li class="rate">
            <p class="rateName">{rate.name}</p>
            <p class="ratePrice">{rate.price}</p>
            <p class="ratePeriod">{rate.period}</p>
          </li>
        ))
      }
    </ul>
    <div class="actions">
      <a class="btn btnSecondary" href={localeUrl('/pricing', locale)}>{t.ratesMore}</a>
    </div>
  </div>
</section>

{/*
  The teachers, and why this section has an eyebrow and no heading.

  Every heading that fits would be a claim this file is not allowed to make: naming them
  spells out `instructor.name`, which is a CMS-owned value and belongs in Sanity
  (`test/contentdrift.test.ts`), and counting them („dvoje instruktora") is a sentence that
  goes stale the day a third person teaches. The names are the heading, and they arrive
  from the dataset.
*/}
<section class="section">
  <div class="wrap">
    <div class="head">
      <p class="eyebrow">{t.teachers}</p>
    </div>
    <ul class="people">
      {
        people.map((person) => (
          <li class="person">
            <p class="personName">{person.name}</p>
            <p class="personRole">{person.role}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<section class="section invert" id="trial">
  <div class="wrap">
    <div class="head">
      <p class="eyebrow">{t.trial}</p>
      <h2 class="displayM">{t.trialLede}</h2>
    </div>
    {/*
      MUSE-7: the form itself, not a "coming soon" email address. Every CTA on the site
      points here, so this is the conversion path. `:target { scroll-margin-top }` in
      base.css is what keeps the landing clear of the fixed header.
    */}
    <TrialForm locale={locale} />
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="head">
      <p class="eyebrow">{t.where}</p>
      <h2 class="displayM">{address}</h2>
    </div>
    <div class="actions">
      <a class="btn btnSecondary" href={STUDIO.maps} target="_blank" rel="noopener noreferrer">
        {t.openMaps}
      </a>
    </div>
  </div>
</section>

<style>
  /*
    The page is centred (MUSE-133): one measure, `text-align: center` on each section's
    header block, and every grid centred inside it. The reference the ticket names does
    the same thing with a container plus a narrow centred header per section, and this is
    that construction with this site's own measure.
  */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    place-items: center;
    min-height: 100svh;
    padding: var(--space-9) var(--space-5);
    text-align: center;
  }
  @media (min-width: 768px) {
    .hero {
      /* Design system §7.2: 100svh mobile, 88vh desktop — `svh`, so a phone's collapsing
         toolbar does not resize the hero mid-scroll. */
      min-height: 88svh;
      padding: var(--space-10) var(--space-7);
    }
  }

  .heroVideo,
  .heroScrim {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .heroVideo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /*
    §7.2's scrim, and the plum tint the ticket asks for: `--band-surface` is plum-ink in
    *both* themes — the same role the masthead and the footer sit on — so the hero does not
    invert with the page. Written with `color-mix()` over a role token because a component
    may not name a brand colour (`npm run ds`).

    **82% to 70%, not §7.2's 78% to 30%, and the difference is measured.** axe reports
    `color-contrast` as *incomplete* over a moving ground, so nothing machine-checks this;
    it was measured off the rendered screenshots instead, sampling the background between
    the glyphs and compositing. At the specified stops this footage — a bright daylight
    studio, not the warm low-lit register §9 describes — gave the lede **3.81:1** and the
    ghost button's gold **1.79:1**, both of which fail AA for text that size. The video
    under the lede is rgb(193, 171, 159) and under the buttons rgb(244, 207, 157); holding
    gold to 4.5:1 over the second one is what sets the floor at 70%.

    So the gradient survives as a gradient and its range is narrow, because the range is
    what the contrast pays for. Measured again at these stops, on the rendered page in
    both themes: eyebrow **5.86:1**, headline **11.12:1**, lede **6.60:1**, and the ghost
    button's lettering **5.57:1** at its worst sample. The next time the footage changes,
    re-measure — these are properties of this clip, not of the design.
  */
  .heroScrim {
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--band-surface) 82%, transparent),
      color-mix(in srgb, var(--band-surface) 70%, transparent)
    );
  }

  .heroContent {
    max-width: 48rem;
    margin-inline: auto;
  }
  /* The hero sits on footage in both themes, so its text takes the band roles rather than
     the page's — cream on plum-ink, gold accent, identical light and dark. */
  .hero .eyebrow {
    color: var(--band-accent);
  }
  .hero .display {
    color: var(--band-text);
  }
  .hero .lede {
    color: var(--band-muted);
  }
  .hero .btnPrimary {
    background: var(--band-fill);
    color: var(--band-fill-text);
  }
  /*
    The ghost button gets a ground of its own, which it does not need anywhere else on the
    site. Gold is the hardest colour to read over this footage — 1.79:1 against the
    brightest frames — and the scrim alone cannot fix that without taking the video down
    to a texture. A fill of the band's own surface keeps the shape a ghost button while
    giving its lettering something fixed to sit on.
  */
  .hero .btnSecondary {
    border-color: var(--band-accent);
    color: var(--band-accent);
    background: color-mix(in srgb, var(--band-surface) 72%, transparent);
  }

  /* §7.4: the control is 44px, an accent hairline circle, bottom-right. */
  .heroToggle {
    position: absolute;
    right: var(--space-5);
    bottom: var(--space-5);
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 1px solid var(--band-line-accent);
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--band-accent);
    cursor: pointer;
  }
  /* Two bars while it plays, a triangle while it does not — one element, no icon file. */
  .heroToggleGlyph {
    width: 11px;
    height: 12px;
    background: linear-gradient(
      to right,
      currentColor 0 35%,
      transparent 35% 65%,
      currentColor 65% 100%
    );
  }
  .heroToggle[aria-pressed='false'] .heroToggleGlyph {
    background: currentColor;
    clip-path: polygon(0 0, 100% 50%, 0 100%);
  }

  .section {
    padding: var(--space-8) var(--space-5);
  }
  @media (min-width: 768px) {
    .section {
      padding: var(--space-10) var(--space-7);
    }
  }
  .sunken {
    background: var(--surface-sunken);
  }
  .wrap {
    max-width: var(--measure-page);
    margin-inline: auto;
    text-align: center;
  }

  /* A section's header block: narrow, centred, and the prose inside it centred with it. */
  .head {
    max-width: 44rem;
    margin-inline: auto;
  }
  .prose {
    margin: var(--space-5) auto 0;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .eyebrow {
    font-family: var(--font-label);
    font-weight: 300;
    font-size: 0.75rem;
    letter-spacing: 0.32em;
    /* Č Ć Ž Š carry marks above the cap line — 1.4 is the floor in Croatian (§4.6) */
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0;
