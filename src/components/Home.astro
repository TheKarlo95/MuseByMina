---
import TrialForm from './TrialForm.astro';
import { localeUrl, type Locale } from '../lib/i18n';
import { CTA, STUDIO } from '../lib/nav';
import {
  formatTime,
  groupByDay,
  LEVEL_NAME,
  LEVEL_PREREQUISITE,
  minutesPhrase,
  uniformDuration,
  WEEKDAY_NAME,
  type ClassEntry,
  type Level,
} from '../lib/schedule';

interface Props {
  locale: Locale;
  /**
   * The studio's address, from Sanity — passed in rather than read here, and that is not
   * a style preference.
   *
   * Astro orders a page's stylesheets by the order it crawls the page's imports, and this
   * component's own `<style>` is inlined while `TrialForm`'s is an external `<link>`.
   * Adding *any* import to this file — above `TrialForm`, below it, anywhere — moves the
   * inlined block past both `<link>`s in `<head>` on `/` and `/en`. Nothing renders
   * differently (both are scoped), but MUSE-20's acceptance test is a byte-for-byte
   * `diff -r` of the built site against the previous deploy, and a moved `<style>` is a
   * byte. Measured, not assumed: three placements, three identical diffs.
   *
   * `src/pages/index.astro` already reads the CMS for its `<title>`, so it hands the
   * address down and this file's import list stays exactly as it was. `Contact.astro`
   * reads directly because it has the same exposure but survives it at one specific
   * import position — see the note there.
   */
  address: string;
  /**
   * The weekly timetable, from `getSchedule()` — the same rows `/schedule` renders.
   *
   * A prop for the reason `address` is a prop: this file's import list cannot grow. It
   * also closes MUSE-11's door from the other side — the doors are derived from the
   * schedule, and the schedule now arrives from the CMS, so the homepage cannot advertise
   * a class the timetable does not have even for one build.
   */
  entries: ClassEntry[];
}
const { locale, address, entries } = Astro.props;

/** As on `/schedule`: the class length is read off the rows, never typed (MUSE-36). */
const minutes = uniformDuration(entries);

const t = {
  hr: {
    eyebrow: 'Plesni studio · Zagreb',
    h1: 'Nauči bachatu u Zagrebu',
    lede: [
      'Bez partnera, bez iskustva.',
      minutes === undefined
        ? 'Razinu biraš po tome koliko dugo plešeš.'
        : `Satovi traju ${minutesPhrase(minutes, 'hr')}, a razinu biraš po tome koliko dugo plešeš.`,
    ].join(' '),
    schedule: 'Pogledaj raspored',
    startHere: 'Nova si u plesu?',
    startLede: 'Dvoja vrata, ne šest. Odaberi ono koje ti odgovara.',
    where: 'Gdje smo',
    openMaps: 'Otvori u Google Maps',
    trial: 'Dođi na probni sat',
    // MUSE-71 removed this sentence's first half, which priced the first class at
    // nothing. The second half is the whole of what the studio has actually said.
    trialLede: 'Javi nam se i dogovorit ćemo termin.',
    doorNudge: { beginner: 'Počni ovdje.' },
  },
  en: {
    eyebrow: 'Dance studio · Zagreb',
    h1: 'Learn bachata in Zagreb',
    lede: [
      'No partner, no experience needed.',
      minutes === undefined
        ? 'Pick your level by how long you have been dancing.'
        : `Classes run ${minutesPhrase(minutes, 'en')}, and you pick your level by how long you have been dancing.`,
    ].join(' '),
    schedule: 'See the schedule',
    startHere: 'New to dancing?',
    startLede: 'Two doors, not six. Pick the one that fits.',
    where: 'Where we are',
    openMaps: 'Open in Google Maps',
    trial: 'Come to a trial class',
    trialLede: 'Get in touch and we will find you a slot.',
    doorNudge: { beginner: 'Start here.' },
  },
}[locale];

/**
 * Widened on purpose: the nudge is written for the beginner door only, and a door
 * without one is correct rather than a missing translation. See the note on `doors`.
 */
const doorNudge: Partial<Record<Level, string>> = t.doorNudge;

/**
 * Which levels get a door. This list is the whole editorial decision, and the
 * only part of a door written on this page.
 *
 * "Two doors, not six" is the design brief's: the people who need telling where
 * to start are the one who has never danced and the one who is a year in.
 * Advanced dancers already know, so advanced deliberately has no door — which is
 * why this is a hand-picked pair of levels and not `LEVELS`.
 */
const DOOR_LEVELS = ['beginner', 'intermediate'] as const satisfies readonly Level[];

/**
 * There are four levels now and still two doors (MUSE-36).
 *
 * `improver` joined `LEVELS` with the real timetable, and it is deliberately *not* a
 * door: the brief's reason for picking two was who needs telling where to start, and
 * somebody a few months in already knows they are not a beginner. A door per level would
 * be four doors, which is the "six doors" the section's own heading rejects.
 */

/**
 * The class a door points at: the first session of that level in the week.
 *
 * MUSE-11 — the day and time used to be typed into this file, and had already
 * drifted: the intermediate door advertised Thursday 20:00, which is an
 * *advanced* class. So the session is derived rather than hand-picked, and a
 * schedule edit can no longer leave the homepage pointing at a class that is not
 * there. `groupByDay` is week-ordered and sorts each day by start time, so
 * "first" means the soonest in the week — the nearest way in.
 */
function firstSession(level: Level): ClassEntry | undefined {
  for (const group of groupByDay(entries)) {
    const entry = group.entries.find((candidate) => candidate.level === level);
    if (entry) return entry;
  }
  return undefined;
}

/**
 * Level name, prerequisite, day and time all come from the schedule; only the
 * **nudge** is page copy.
 *
 * ---
 *
 * **The door's „who is this for?" line is `LEVEL_PREREQUISITE`** (MUSE-18).
 *
 * It used to be a `doorWho` table in the copy block above, and
 * `doorWho.intermediate` was byte-identical to
 * `LEVEL_PREREQUISITE[locale].intermediate` in both languages — „Plešeš oko godinu
 * dana." / "About a year of dancing.". Exactly the drift MUSE-11 had just fixed for
 * the level *name*, one field over, on the same cards, and nothing watched it:
 * MUSE-11's guard only knew about `LEVEL_NAME`. The beginner entry was worse in a
 * quieter way — it said the same *fact* as the prerequisite in different words
 * („Nikad nisi plesao/la." vs „Bez iskustva — nikad nisi plesao ni plesala."), so
 * the homepage and `/schedule` already disagreed about what a beginner is, in a way
 * no diff would ever flag as a conflict.
 *
 * So the prerequisite is read, and `t.doorNudge` keeps only the part that is
 * genuinely this page's: „Počni ovdje." / "Start here.", which is a call to action
 * rather than a description of the level and belongs to the beginner door alone. A
 * door with no nudge renders the prerequisite by itself.
 *
 * `test/home.test.ts` now guards `LEVEL_PREREQUISITE` the same way it guards
 * `LEVEL_NAME`, so this cannot be pasted back.
 *
 * **A door onto a level nobody teaches is dropped, not a build failure** — and that
 * changed in MUSE-36, so the reasoning is worth having here.
 *
 * MUSE-11 threw: "a door onto a level nobody teaches is worse than one door fewer". That
 * was right while the rows were a file in this repository, where a missing beginner class
 * could only be a developer's mistake and a loud build failure was the cheapest way to
 * find it. The rows are CMS content now, and `scheduleSlot.active` exists precisely so
 * Mina can take a class off the timetable for the summer — so the same rule would mean a
 * legitimate edit in the Studio stops the site building, on every pull request and every
 * scheduled rebuild, with an error about a homepage door.
 *
 * What MUSE-11 was actually protecting is still protected: a door never shows a day and
 * time that is not in the schedule, because it has none to show unless there is a class.
 * The section going *empty* is still a build failure, below — "New to dancing?" with no
 * way in is a broken page rather than a smaller one.
 */
const doors = DOOR_LEVELS.flatMap((level) => {
  const entry = firstSession(level);
  if (!entry) return [];
  return [
    {
      level,
      name: LEVEL_NAME[locale][level],
      when: `${WEEKDAY_NAME[locale][entry.day]} · ${formatTime(entry.start)}`,
      who: [LEVEL_PREREQUISITE[locale][level], doorNudge[level]].filter(Boolean).join(' '),
    },
  ];
});

if (doors.length === 0) {
  throw new Error(
    `The homepage's „${t.startHere}" section has no doors: the schedule holds no ` +
      `${DOOR_LEVELS.join(' or ')} class. One of those two has to be on the timetable — ` +
      `check that their slots are switched on in the Studio.`,
  );
}
---

<section class="hero">
  <p class="eyebrow">{t.eyebrow}</p>
  <h1 class="display">{t.h1}</h1>
  <p class="lede">{t.lede}</p>
  <div class="actions">
    <a class="btn btnPrimary" href={localeUrl(CTA.route, locale)}>{CTA.label[locale]}</a>
    <a class="btn btnSecondary" href={localeUrl('/schedule', locale)}>{t.schedule}</a>
  </div>
</section>

<section class="section sunken">
  <div class="wrap">
    <p class="eyebrow">{t.startHere}</p>
    <h2 class="displayM">{t.startLede}</h2>
    <ul class="cards two">
      {
        doors.map((d) => (
          <li class="card" data-door={d.level}>
            {/*
              `data-level-name` is the site-wide contract (MUSE-11): an element
              that shows a level's name declares which level it is, so the suite
              can check every one of them against `LEVEL_NAME` and compare this
              page against `/schedule` without matching on copy.
            */}
            <p class="cardName" data-level-name={d.level}>{d.name}</p>
            <p class="cardWhen" data-when>{d.when}</p>
            <p class="cardWho">{d.who}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

{/*
  **„Tri okusa, jedan ples" was here, and nothing replaces it** (MUSE-36).

  Three cards — Traditional / Moderna / Sensual — each with a paragraph about what that
  style is like. It was the homepage's most substantial piece of writing and it described
  a distinction the studio does not make: the three styles were invented in the foundation
  commit alongside the thirteen invented classes, and the real timetable has no style
  dimension at all. Copy that is well written about something untrue is worse than no copy,
  because it reads as authoritative.

  Nothing takes its place on purpose. The honest candidates were all facts the page already
  carries — the two doors name the days and times, `/schedule` is one click from the hero,
  the address is two sections down — and writing a section about what a class is like would
  be inventing the next thing somebody has to come back and delete. A section here is a
  content decision for Mina, not a gap to be filled by whoever happened to notice it.
*/}

<section class="section invert" id="trial">
  <div class="wrap">
    <p class="eyebrow">{t.trial}</p>
    <h2 class="displayM">{t.trialLede}</h2>
    {/*
      MUSE-7: the form itself, not a "coming soon" email address. Every CTA on the site
      points here, so this is the conversion path. `:target { scroll-margin-top }` in
      base.css is what keeps the landing clear of the fixed header.
    */}
    <TrialForm locale={locale} />
  </div>
</section>

<section class="section">
  <div class="wrap">
    <p class="eyebrow">{t.where}</p>
    <h2 class="displayM">{address}</h2>
    <a class="btn btnSecondary" href={STUDIO.maps} target="_blank" rel="noopener noreferrer">
      {t.openMaps}
    </a>
  </div>
</section>

<style>
  .hero {
    max-width: 1280px;
    margin-inline: auto;
    padding: var(--space-9) var(--space-5) var(--space-8);
  }
  @media (min-width: 768px) {
    .hero {
      padding: var(--space-11) var(--space-7) var(--space-10);
    }
  }

  .section {
    padding: var(--space-8) var(--space-5);
  }
  @media (min-width: 768px) {
    .section {
      padding: var(--space-10) var(--space-7);
    }
  }
  .sunken {
    background: var(--surface-sunken);
  }
  .wrap {
    max-width: 1280px;
    margin-inline: auto;
  }

  .eyebrow {
    font-family: var(--font-label);
    font-weight: 300;
    font-size: 0.75rem;
    letter-spacing: 0.32em;
    /* Č Ć Ž Š carry marks above the cap line — 1.4 is the floor in Croatian (§4.6) */
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0;
    max-width: none;
  }

  .display {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(3.25rem, 12vw, 8.5rem);
    line-height: 0.92;
    letter-spacing: -0.02em;
    text-wrap: balance;
    margin: var(--space-4) 0 0;
  }
  .displayM {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.125rem, 5vw, 3.75rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-wrap: balance;
    margin: var(--space-4) 0 0;
  }

  .lede {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--text-muted);
    margin-top: var(--space-5);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-7);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding-inline: var(--space-6);
    border-radius: var(--radius-full);
    border: 1px solid transparent;
    font-family: var(--font-label);
    font-size: 0.8125rem;
    letter-spacing: 0.28em;
    line-height: 1.4;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition:
      transform var(--dur-fast) var(--ease),
      filter var(--dur-fast) var(--ease);
  }
  @media (min-width: 768px) {
    .btn {
      min-height: 56px;
    }
  }
  .btn:hover {
    transform: translateY(-1px);
    filter: brightness(1.06);
  }
  .btnPrimary {
    background: var(--btn-bg);
    color: var(--btn-fg);
  }
  .btnSecondary {
    border-color: var(--accent);
    color: var(--accent);
  }

  .cards {
    list-style: none;
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-7);
  }
  @media (min-width: 768px) {
    .cards {
      gap: var(--space-6);
    }
    .cards.two {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* No drop shadows anywhere in this system — depth is surface value plus hairlines. */
  .card {
    border: 1px solid var(--line-accent);
    border-radius: var(--radius-sm);
    padding: var(--space-5);
  }
  @media (min-width: 768px) {
    .card {
      padding: var(--space-6);
    }
  }
  .cardName {
    font-family: var(--font-display);
    font-size: clamp(1.625rem, 3vw, 2.125rem);
    line-height: 1.15;
    margin: 0;
  }
  .cardWhen {
    font-family: var(--font-label);
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--accent);
    margin: var(--space-2) 0 0;
  }
  .cardWho {
    font-size: 0.9375rem;
    color: var(--text-muted);
    margin-top: var(--space-3);
  }
</style>
