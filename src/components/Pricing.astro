---
import {
  ENROL_ANCHOR,
  PRICING_COPY,
  formatPrice,
  packageValue,
  periodName,
  resolveFeatured,
} from '../lib/pricing';
import type { Locale } from '../lib/i18n';
import { getPricingTiers } from '../lib/sanity';
import TrialForm from './TrialForm.astro';

/**
 * **The price list and the enrolment form, on one page.**
 *
 * The decision and the action sit together, which is the ticket's reading of the two
 * reference sites: Faith Connect publishes no prices at all, so every pricing question
 * becomes a DM; axcentdance.com fuses the prices and the sign-up. So the tiers are the
 * page and the form is the bottom of it, and a tier's button is a link into that form
 * with the package already chosen.
 *
 * ---------------------------------------------------------------------------
 * **`/pricing` is a route as of MUSE-59, and this is what it took.**
 *
 * MUSE-22 built this component and deliberately left it unreachable: the dataset held no
 * `pricingTier` document, because there were no agreed prices, and `getPricingTiers()`
 * leaves `minimum` at 1 — so a route pointing here would have failed every build on
 * `main`, the pull request checks, the deploy and MUSE-21's scheduled rebuild with it.
 *
 * What ended that was content, not code: the studio confirmed its rates, and
 * `test/pricing.test.ts` holds them as a frozen list, because a wrong price is the worst
 * thing this site could invent: it is MUSE-36's failure (plausible placeholder content
 * that reached production and stayed) plus a commercial claim somebody budgets around.
 *
 * **MUSE-59 published one of three, which is the other half of that rule** (MUSE-73).
 * The frozen list was „two periods and no others", relayed in good faith and incomplete:
 * the studio's own enrolment form charges a regular monthly rate, a student monthly rate
 * and a drop-in, and the two-month package the site published was none of them. So every
 * guard on this page was pointed at the site saying *more* than is true and nothing
 * watched it saying *less* — a reader on `/pricing` concluded there was no student rate.
 * The receipt is three entries now, and a fourth document is still a red test.
 *
 * The ordering that got it here is worth knowing, because the next routed page needs it
 * too: the `pricingTier` and `page` documents were imported into the live dataset
 * **before** the branch adding the route was merged. The two cannot land in one push,
 * and `npm run sanity:seed` is a write to Mina's content.
 *
 * `test/pricing.test.ts` still renders this component through Astro's container API for
 * the dataset shapes a seed cannot hold at once — two tiers ticked as featured, none,
 * a draft — and asserts the real page against `dist` beside it.
 * ---------------------------------------------------------------------------
 *
 * Shape is design system §7.2, *Pricing tier*: cards on `--surface-raised`; the featured
 * one gets `1px solid var(--accent)` and an overlapping eyebrow tab and **never an
 * accent fill**, which would overpower the row in either theme; anatomy is tier name →
 * price (`display-m`) → period → rule → feature list with `✦` markers → button.
 *
 * Every price, package name and feature line comes from Sanity. `src/lib/pricing.ts`
 * holds the four words that do not, and the formatting rules that are code by
 * instruction (CLAUDE.md: time and currency formatting are never CMS fields).
 */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = PRICING_COPY[locale];

/**
 * `minimum` is left at its default of 1: a pricing page with no tiers on it is the state
 * this page exists to end, and publishing it empty would be worse than not publishing
 * it. The build fails naming `pricingTier`.
 */
const { tiers, warning } = resolveFeatured(await getPricingTiers());

/**
 * "Exactly one tier is featured" is a constraint across documents that the schema cannot
 * express, so `resolveFeatured` picks deterministically and never throws — the full
 * argument is in `src/lib/pricing.ts`. What it cannot do is tell anybody, so that
 * happens here, once, in the build log, naming the documents. The place it also belongs
 * is the Studio, as an async `Rule.custom` on `pricingTier.featured`.
 *
 * MUSE-59 shipped the page and did **not** add that rule, which is a decision rather
 * than an omission: it is a schema change, so it costs a regenerated `schema.json`, a
 * regenerated type file, a new stamp and a Studio redeploy, and it guards a state that
 * cannot exist in the dataset today — none of the three seeded rates is featured, so
 * there is no second box to tick by accident. It becomes worth doing the day somebody
 * ticks the first one. Until then the build log is the whole of the report, and that is
 * enough, because the page it describes still renders correctly.
 *
 * **MUSE-73 added a third rate and deliberately featured none of them.** Three cards is
 * the arrangement a "most popular" tab is written for, and nobody has said which of the
 * studio's rates that would be — inventing commercial emphasis is MUSE-36's defect with
 * a border around it.
 */
if (warning !== undefined) console.warn(`[pricing] ${warning}`);

/** The form's package `<select>`: one option per tier, in the order the page shows them. */
const packages = tiers.map((tier) => ({
  value: packageValue(tier),
  label: tier.name[locale],
}));
---

<section class="hero">
  <h1 class="display">{copy.title}</h1>
</section>

<section class="section">
  <ul class="tiers">
    {
      tiers.map((tier) => (
        <li class="cell">
          <article
            class:list={['card', tier.featured && 'featured']}
            data-tier={tier.id}
            data-featured={tier.featured ? 'true' : undefined}
          >
            {/*
              The overlapping eyebrow tab (§7.2). It is inside the card and pulled up
              over its own top border, so the hairline reads as a tab cut into it
              rather than as a badge floating above a box.
            */}
            {tier.featured && (
              <p class="tab" data-tab>
                {copy.featuredTab}
              </p>
            )}

            {/*
              `h2`, not the `h3` this shipped as (MUSE-75). The page went from its `h1`
              straight to an `h3` on every card, with its only `h2` (`enrolHeading`)
              *after* them — a skipped level in both locales, which is design system
              §11.8 and which a screen-reader user navigating by heading hears as a
              missing section. (A tier's name is `pricingTier.name`, so this note may not
              quote one: `test/contentdrift.test.ts` reads comments too, correctly.)

              A `h2` rather than a section heading over the list, because a tier *is* a
              top-level section of a price list and the alternative is a word nobody at
              the studio has chosen: „Paketi" would be invented copy on a page whose every
              other string is either Mina's or in `PRICING_COPY` with a reason. §11.8 also
              settles the thing that makes this look wrong — *display size never determines
              heading level* — so `.name` keeps its own type scale and the markup says what
              the outline is.
            */}
            <h2 class="name">{tier.name[locale]}</h2>

            {/*
              The price. `--font-display` at `display-m`, which bottoms out at 2.125rem —
              well above Cormorant's 26px floor, below which the `đ` crossbar vanishes.
              Numerals are NOT set here: `font-variant-numeric: lining-nums tabular-nums`
              is declared once on the document in `src/styles/base.css`, and because the
              property is a single inherited value a declaration here would *replace* it
              and bring back MUSE-14 — `42 €` reading as a superscript — with the column
              still neatly aligned. `npm run ds` fails the build if anyone tries.

              `data-price` is read by `test/pricing.test.ts`, which asserts this element's
              text is exactly what `priceEur` formats to. It is the one number on the
              page a visitor may act on.
            */}
            <p class="price" data-price>{formatPrice(tier.priceEur, locale)}</p>
            <p class="period">{periodName(tier.period, locale)}</p>

            <ul class="features">
              {tier.features.map((feature) => (
                <li class="feature">
                  <span class="mark" aria-hidden="true">
                    ✦
                  </span>
                  <span>{feature[locale]}</span>
                </li>
              ))}
            </ul>

            {/*
              The action, on the same page. An `<a>` rather than a `<button>` because
              without JavaScript it still does the useful half — it lands on the
              enrolment block, where `TrialForm`'s `<noscript>` offers the studio inbox
              (the form itself is hidden when scripting is off, MUSE-15). With
              JavaScript the script below also sets the package and moves focus there.

              `aria-label` adds the package name so a screen-reader user does not hear
              "Choose" three times with nothing to tell them apart; it starts with the
              visible label, which is WCAG 2.5.3.
            */}
            <a
              class="btn"
              href={`#${ENROL_ANCHOR}`}
              data-choose={packageValue(tier)}
              aria-label={`${copy.choose}: ${tier.name[locale]}`}
            >
              {copy.choose}
            </a>
          </article>
        </li>
      ))
    }
  </ul>
</section>

<section class="section sunken" id={ENROL_ANCHOR}>
  <div class="wrap">
    <h2 class="displayM">{copy.enrolHeading}</h2>
    <TrialForm locale={locale} packages={packages} />
  </div>
</section>

<script>
  /**
   * Carry the chosen package into the form, and put the keyboard there.
   *
   * Progressive, not required: the `href` is a real fragment, so with scripting off the
   * link still lands on the enrolment block — which is the only honest destination there
   * is, since the form is hidden without JavaScript and its `<noscript>` offers the
   * studio inbox instead. Nothing here is the difference between enrolling and not.
   *
   * Focus moves to the select rather than being left on the card, because a keyboard
   * user who followed a fragment link is otherwise still three sections up; and because
   * focusing it is what makes a screen reader announce the value that was just set.
   */
  const select = document.querySelector<HTMLSelectElement>('select[name="package"]');

  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-choose]')) {
    link.addEventListener('click', () => {
      if (!select) return;
      const wanted = link.dataset.choose ?? '';
      // Only if the option is really there: the list is built from the same tiers, so a
      // mismatch means the page was rebuilt around the script and silently selecting
      // nothing beats selecting the wrong package.
      if (![...select.options].some((option) => option.value === wanted)) return;
      select.value = wanted;

      /**
       * **Focused in a later task, not in this one.** Measured: focusing it here does
       * nothing. The click event is dispatched *before* the link's default action, and
       * that action — navigating to `#enrol` — resets focus, so `document.activeElement`
       * ends up `<body>`. Deferring puts the focus call after the navigation.
       */
      setTimeout(() => select.focus({ preventScroll: true }), 0);
    });
  }
</script>

<style>
  .hero {
    max-width: 1280px;
    margin-inline: auto;
    padding: var(--space-8) var(--space-5) var(--space-7);
  }
  @media (min-width: 768px) {
    .hero {
      padding: var(--space-10) var(--space-7) var(--space-8);
    }
  }

  .section {
    padding: var(--space-8) var(--space-5);
  }
  @media (min-width: 768px) {
    .section {
      padding: var(--space-10) var(--space-7);
    }
  }
  .sunken {
    background: var(--surface-sunken);
  }
  .wrap {
    max-width: 1280px;
    margin-inline: auto;
  }

  .display {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.75rem, 9vw, 6rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .displayM {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.125rem, 5vw, 3.75rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  /* §5: gap between cards is 16 on mobile, 32 on desktop. The extra top padding is the
     room the featured card's tab occupies above its own edge — without it the tab is
     clipped by the section, and giving the card itself the padding would make one card
     taller than the others. */
  .tiers {
    max-width: 1280px;
    margin-inline: auto;
    padding-top: var(--space-4);
    list-style: none;
    display: grid;
    gap: var(--space-4);
  }
  @media (min-width: 768px) {
    /* **A wrapping, centred row of equal cards — and the width is arithmetic, not taste.**

       This was `grid-template-columns: repeat(auto-fit, minmax(15rem, 24rem))` with
       `justify-content: center`, which MUSE-59 chose over `1fr` for a reason that still
       holds: with `1fr` two tracks split the row into a pair of 600px cards holding a
       name, a price, one line and a button — a price list that reads as though a third
       card failed to load. A ceiling keeps a tier the same size whether there are two of
       them or four, which is what makes the row comparable; a card that is wider because
       there are fewer of them is a card the eye weighs differently.

       **MUSE-73 made it three and the ceiling did not fit.** §7.2 is „three cards", and
       24rem is 384px: three of them plus two 32px gaps is 1216, against a row of
       1280 − 2 × 48px of section padding = 1184. So the third card wrapped, at the exact
       width this design is drawn at, and `auto-fit` put it in the first track of a
       centred two-track grid — a lone card hanging under the left-hand one. The number
       was never checked against the padding and the gaps, and with two tiers nothing
       could show it.

       So the ceiling is **23rem**: 3 × 368 + 2 × 32 = 1168, which is 16px inside 1184.
       That arithmetic is the whole reason for the value — change the container width,
       the section padding or the gap and it has to be redone. `npm run shots` with
       `ROUTE=/pricing` is how you see it; the budget run opens the same 1280.

       And it is **flex rather than grid**, which is the half that is about more than
       three: `auto-fit` centres the *track set*, so a wrapped card lands in track 1 and
       reads as a card that failed to load, while a flex line centres itself — the day a
       fourth rate makes it 3 + 1 the orphan sits under the middle of the row. Nothing
       else changes: `flex: 0 1 23rem` with `min-width: 15rem` is the same floor and
       ceiling the track range was, so §10's rule that the content decides the size holds
       and there is still no `width` on a card. Flex only shrinks a line that overflows,
       and a line is filled at the basis, so every card is the same width whichever line
       it is on. */
    .tiers {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: var(--space-6);
    }
    .cell {
      flex: 0 1 23rem;
      min-width: 15rem;
    }
  }
  .cell {
    display: grid;
  }

  /* §7.2: cards on --surface-raised. On cream that fill is a 1.11:1 step, so the card is
     defined by its hairline and not by its background — and §5 is explicit that a shadow
     must not be added to compensate, in either theme. */
  /* Flex column rather than grid, for one reason: `margin-top: auto` on the button.
     Three tiers with one, two and three features each are three different heights, and
     with the buttons at the end of the content they sit at three different heights too —
     which reads as unfinished and makes the row harder to compare. The column stretches
     to the tallest card and the button is pushed to the bottom of each. */
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6) var(--space-5);
    background: var(--surface-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
  }
  @media (min-width: 768px) {
    .card {
      padding: var(--space-7) var(--space-6);
    }
  }

  /* The featured treatment, in full: one hairline in the accent role, and the tab below.
     Never a fill — "which would overpower the row in either theme" (§7.2). Because it is
     a role token rather than a brand colour it is gold on plum in dark and gold-deep on
     white in light, with no per-theme override here (§2). */
  .featured {
    border: 1px solid var(--accent);
  }

  /* Pulled up over the card's own top border, so it reads as a tab in the hairline. */
  .tab {
    position: absolute;
    top: 0;
    left: var(--space-5);
    transform: translateY(-50%);
    padding: var(--space-1) var(--space-4);
    max-width: calc(100% - 2 * var(--space-5));
    background: var(--surface-raised);
    border: 1px solid var(--accent);
    border-radius: var(--radius-full);
    color: var(--accent);
    font-family: var(--font-label);
    font-weight: 300;
    font-size: 0.75rem;
    letter-spacing: 0.32em;
    /* Č Ć Ž Š carry marks above the cap line — 1.4 is the floor in Croatian (§4.6) */
    line-height: 1.4;
    text-transform: uppercase;
  }

  .name {
    font-family: var(--font-label);
    font-size: 0.8125rem;
    letter-spacing: 0.28em;
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* `display-m` (§4). The clamp is the specification, not a suggestion: its floor of
     2.125rem is above Cormorant's 26px display floor, below which `đ` loses its
     crossbar. No `font-variant-numeric` here — see the note in the markup. */
  .price {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.125rem, 5vw, 3.75rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--text);
  }

  .period {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--text-subtle);
  }

  /* The rule in §7.2's anatomy: price → period → rule → features. */
  .features {
    list-style: none;
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-2);
    padding-top: var(--space-5);
    /* §5: body → CTA is 32 on desktop; the card's own 12px gap makes up the rest. */
    margin-bottom: var(--space-5);
    border-top: 1px solid var(--line);
  }
  .feature {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-muted);
  }
  .mark {
    flex: none;
    color: var(--accent);
    font-size: 0.75rem;
  }

  /* §7.5 primary. No width and no `white-space: nowrap`: the label decides the size, in
     both languages and in both directions (§10). `margin-top: auto` is what pushes it to
     the bottom of a card that is shorter than its neighbours. */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    margin-top: auto;
    padding-inline: var(--space-6);
    border: 1px solid transparent;
    border-radius: var(--radius-full);
    background: var(--btn-bg);
    color: var(--btn-fg);
    font-family: var(--font-label);
    font-size: 0.8125rem;
    letter-spacing: 0.28em;
    line-height: 1.4;
    text-transform: uppercase;
    text-decoration: none;
    transition:
      transform var(--dur-fast) var(--ease),
      filter var(--dur-fast) var(--ease);
  }
  @media (min-width: 768px) {
    .btn {
      min-height: 56px;
    }
  }
  .btn:hover {
    transform: translateY(-1px);
    filter: brightness(1.06);
  }
</style>
