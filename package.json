{
  "name": "musebymina",
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/check-sanity.mjs && astro check && astro build",
    "preview": "node scripts/preview.mjs",
    "typecheck": "astro check",
    "test": "vitest run",
    "a11y": "node scripts/a11y.mjs",
    "shots": "node scripts/screenshot-themes.mjs",
    "astro": "astro",
    "ds": "node scripts/check-tokens.mjs",
    "budget": "node scripts/budget.mjs",
    "format": "prettier --write",
    "format:check": "node scripts/check-format.mjs",
    "ux:schedule": "node scripts/schedule-ux.mjs",
    "worktrees:sweep": "node scripts/sweep-worktrees.mjs",
    "sanity:types": "sanity schema extract --path sanity/schema.json --enforce-required-fields --force && sanity typegen generate && node scripts/stamp-sanity.mjs",
    "sanity:check": "node scripts/check-sanity.mjs",
    "sanity:read": "node scripts/sanity-read-check.mjs",
    "sanity:seed": "sanity dataset import content/seed.ndjson --replace --dataset ${SANITY_DATASET:-production}",
    "sanity:seed:check": "node scripts/sanity-seed-check.mjs",
    "sanity:seed:release": "node scripts/sanity-seed-release.mjs",
    "sanity:dev": "sanity dev",
    "sanity:build": "sanity build .sanity/studio --yes",
    "sanity:deploy": "sanity deploy .sanity/studio --yes"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@sanity/client": "8.9.0",
    "astro": "^7.3.6",
    "groq": "^6.18.0"
  },
  "allowScripts": {
    "esbuild": true
  },
  "private": true,
  "description": "Muse by Mina — dance studio website, Zagreb",
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@sanity/validation": "6.18.0",
    "@types/node": "^26.6.4",
    "groq-js": "2.0.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "sanity": "^6.18.0",
    "styled-components": "^6.5.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
